@using Shared.DTO.Historique

<div class="card mb-3 shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-1">
                Transaction #@Transaction.TransactionId
            </h6>
            <small class="text-muted">
                @Transaction.DateDebutNegociation.ToString("dd/MM/yyyy")
            </small>
        </div>

        <div class="text-end">
            <span class="badge @(Transaction.TypeTransaction == "Acheteur" ? "bg-success" : "bg-primary")">
                @Transaction.TypeTransaction
            </span>
            <div class="fw-bold mt-1">
                @Transaction.Montant €
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public TransactionHistoriqueDTO Transaction { get; set; } = default!;
}
