@page "/product/{Id:int}"
@rendermode InteractiveServer

<PageTitle>@productTitle - Clothes2U</PageTitle>

<!-- Navigation Bar -->
<NavBar />

<div class="product-detail-page">
    <div class="product-container">
        <!-- Left Side - Product Image -->
        @if (VM_Annonces.annonceDetail != null)
        {
            <div class="product-image-section">
            <div class="main-image"></div>
            <button class="close-btn" @onclick="GoBack">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <!-- Right Side - Product Info -->
        <div class="product-info-section">
            <!-- Category Badge -->
            <div class="category-badge">Shirts & T-Shirts</div>

            <!-- Title -->
            <h1 class="product-title">@VM_Annonces.annonceDetail.Title</h1>

            <!-- Brand & Price -->
            <div class="brand-price-row">
                <span class="brand-name">Adidas</span>
                <span class="product-price">20.99€</span>
            </div>

            <!-- Price Status - Only one shows based on isNegotiable -->
            <div class="price-status">
                @if (isNegotiable)
                {
                    <span class="badge badge-negotiable">Prix négociable</span>
                }
                else
                {
                    <span class="badge badge-non-negotiable">Prix non négociable</span>
                }
            </div>

            <!-- Actions Row -->
            <div class="actions-row">
                <button class="btn-action" @onclick="ToggleFavorite">
                    <i class="bi bi-heart@(isFavorite ? "-fill" : "")"></i>
                </button>
                <button class="btn-action">
                    <i class="bi bi-three-dots"></i>
                </button>
                <button class="btn-action">
                    <i class="bi bi-share"></i>
                </button>
            </div>

            <!-- Seller Info -->
            <div class="seller-section">
                <div class="seller-avatar"></div>
                <div class="seller-info">
                    <h3 class="seller-name">Daniel</h3>
                    <div class="seller-rating">
                        <i class="bi bi-star-fill"></i>
                        <span>4.8 (100 avis)</span>
                    </div>
                </div>
            </div>

            <!-- Product Details Grid -->
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">Taille</div>
                    <div class="detail-value">XL</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Etat</div>
                    <div class="detail-value">Très bon état</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Couleur</div>
                    <div class="detail-value">Vert</div>
                </div>
            </div>

            <!-- Description -->
            <div class="description-section">
                <h3 class="section-title">Description</h3>
                <p class="description-text">
                    T-Shirt Adidas en excellent état. Porté seulement quelques fois. Matière comfortable, couleur vert.
                </p>
            </div>
                }

            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="btn-secondary" @onclick="ContactSeller">
                    Contacter le vendeur
                </button>
                <button class="btn-secondary" @onclick="MakeOffer">
                    Faire une offre
                </button>
            </div>

            <button class="btn-primary" @onclick="BuyProduct">
                Acheter l'article
            </button>
        </div>
        }
    </div>
    

    <!-- Similar Products Section -->
    <div class="similar-section">
        <h2 class="similar-title">Produits Similaires</h2>
        <div class="similar-grid">
            @for (int i = 0; i < 3; i++)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        <div class="product-image"></div>
                        <button class="wishlist-btn">
                            <i class="bi bi-heart"></i>
                        </button>
                    </div>
                    <div class="product-card-info">
                        <h3 class="card-title">T-Shirt Adidas</h3>
                        <p class="card-brand">Adidas</p>
                        <div class="card-meta">
                            <span class="card-size">Taille XL</span>
                            <span class="card-condition">Très bon état</span>
                        </div>
                        <div class="card-footer">
                            <span class="card-price">20.99€</span>
                            <span class="card-seller">par Daniel</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await VM_Annonces.LoadAnnonceDetail(Id);
    }

    private string productTitle = "T-Shirt Adidas à revendre! Très bon état!";
    private bool isFavorite = false;
    private bool isNegotiable = true; // Change this to false to show "Prix non négociable"

    private void ToggleFavorite()
    {
        isFavorite = !isFavorite;
    }

    private void GoBack()
    {
        // TODO: Navigate back
    }

    private void ContactSeller()
    {
        // TODO: Open contact/message dialog
    }

    private void MakeOffer()
    {
        // TODO: Open make offer dialog
    }

    private void BuyProduct()
    {
