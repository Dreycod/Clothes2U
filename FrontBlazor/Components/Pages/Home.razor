@page "/"
@inject IJSRuntime JS
@inject HomeViewModel VM_Home
@inject AnnoncesViewModel VM_Annonces
@inject FrontBlazor.Models.StateServices.IStateService<FrontBlazor.Models.Utilisateur> UserStateService


<PageTitle>Clothes2U - Home</PageTitle>

<NavBar/>


<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-content">
    </div>
</div>

<!-- Recommendations Section -->
<div class="section-container">
    <div class="section-header">
        <h2 class="section-title">RECOMMENDATIONS</h2>
        <div class="carousel-controls">
            <button class="carousel-btn">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="carousel-btn">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    <div class="product-grid">
        @for (int i = 0; i < 6; i++)
        {
            <div class="product-card">
                <div class="product-image-container">
                    <div class="product-image"></div>
                    <button class="wishlist-btn">
                        <i class="bi bi-heart"></i>
                    </button>
                </div>
                <div class="product-info">
                    <h3 class="product-title">T-Shirt Adidas</h3>
                    <div class="product-meta">
                        <span class="product-size">Taille XL</span>
                        <span class="product-condition">Très bon état</span>
                    </div>
                    <div class="product-footer">
                        <span class="product-price">20.99€</span>
                        <span class="product-seller">par Daniel</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Categories Section -->
<div class="categories-section">
    <div class="category-card category-femmes">
        <div class="category-overlay">
            <h3 class="category-title">Femmes</h3>
        </div>
    </div>
    <div class="category-card category-hommes">
        <div class="category-overlay">
            <h3 class="category-title">Hommes</h3>
        </div>
    </div>
    <div class="category-card category-enfants">
        <div class="category-overlay">
            <h3 class="category-title">Enfants</h3>
        </div>
    </div>
    <div class="category-card category-accessoires">
        <div class="category-overlay">
            <h3 class="category-title">Accessoires</h3>
        </div>
    </div>
</div>

<!-- Trends Section -->
<div class="section-container">
    <div class="section-header">
        <h2 class="section-title">TENDANCES</h2>
        <p class="section-subtitle">Les articles les plus populaires</p>
    </div>

    <div class="product-grid">
        @for (int i = 0; i < 8; i++)
        {
            <div class="product-card">
                <div class="product-image-container">
                    <div class="product-image"></div>
                    <button class="wishlist-btn">
                        <i class="bi bi-heart"></i>
                    </button>
                </div>
                <div class="product-info">
                    <h3 class="product-title">T-Shirt Adidas</h3>
                    <div class="product-meta">
                        <span class="product-size">Taille XL</span>
                        <span class="product-condition">Très bon état</span>
                    </div>
                    <div class="product-footer">
                        <span class="product-price">20.99€</span>
                        <span class="product-seller">par Daniel</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
