@page "/search"
@rendermode InteractiveServer

<PageTitle>Rechercher - Clothes2U</PageTitle>

<!-- Navigation Bar -->
<NavBar />

<div class="search-page">
    <!-- Hero Banner -->
    <div class="search-hero"></div>

    <div class="search-container">
        <!-- Page Header -->
        <div class="search-header">
            <div>
                <h1 class="search-title">Rechercher des articles</h1>
                <p class="search-subtitle">
                    Paramétrez le filtre pour trouver ce qui vous intéresse le plus
                </p>
            </div>
        </div>

        <div class="search-content">
            <!-- Filters Sidebar -->
            <aside class="filters-sidebar">
                <div class="filters-header">
                    <h3>Filtres</h3>
                    <button class="reset-btn" @onclick="ResetFilters">Réinitialiser</button>
                </div>

                <!-- Type de vêtement -->
                <div class="filter-section">
                    <h4 class="filter-title">Type de vêtement</h4>
                    <div class="filter-options">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="filterShirts" />
                            <span>Shirts & T-Shirts</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="filterPants" />
                            <span>Pantalons</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="filterDresses" />
                            <span>Robes</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="filterCoats" />
                            <span>Vestes & Manteaux</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="filterShoes" />
                            <span>Chaussures</span>
                        </label>
                    </div>
                </div>

                <!-- Marque -->
                <div class="filter-section">
                    <h4 class="filter-title">Marque</h4>
                    <div class="filter-options">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="brandAdidas" />
                            <span>Adidas</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="brandNike" />
                            <span>Nike</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="brandZara" />
                            <span>Zara</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="brandLevis" />
                            <span>Levi's</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="brandOther" />
                            <span>Je connais pas d'autre</span>
                        </label>
                    </div>
                </div>

                <!-- Taille -->
                <div class="filter-section">
                    <h4 class="filter-title">Taille</h4>
                    <div class="size-buttons">
                        <button type="button" class="size-btn @(sizeXL ? "active" : "")" @onclick="() => sizeXL = !sizeXL">XL</button>
                        <button type="button" class="size-btn @(sizeS ? "active" : "")" @onclick="() => sizeS = !sizeS">S</button>
                        <button type="button" class="size-btn @(sizeM ? "active" : "")" @onclick="() => sizeM = !sizeM">M</button>
                        <button type="button" class="size-btn @(sizeL ? "active" : "")" @onclick="() => sizeL = !sizeL">L</button>
                        <button type="button" class="size-btn @(sizeXS ? "active" : "")" @onclick="() => sizeXS = !sizeXS">XS</button>
                        <button type="button" class="size-btn @(sizeXXL ? "active" : "")" @onclick="() => sizeXXL = !sizeXXL">XXL</button>
                    </div>
                </div>

                <!-- Prix -->
                <div class="filter-section">
                    <h4 class="filter-title">Prix</h4>
                    <div class="price-range">
                        <div class="price-inputs">
                            <span>0€</span>
                            <span>@priceMax€</span>
                        </div>
                        <input type="range" min="0" max="500" @bind="priceMax" class="price-slider" />
                    </div>
                </div>

                <!-- État -->
                <div class="filter-section">
                    <h4 class="filter-title">État</h4>
                    <div class="filter-options">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="conditionNew" />
                            <span>Comme neuf</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="conditionVeryGood" />
                            <span>Très bon état</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="conditionGood" />
                            <span>Bon état</span>
                        </label>
                    </div>
                </div>

                <!-- Apply Button -->
                <button class="apply-filters-btn" @onclick="ApplyFilters">
                    Appliquer les filtres
                </button>
            </aside>

            <!-- Products Grid -->
            <div class="products-section">
                @if (VM_Annonces.IsLoading)
                {
                    <div class="loading-state">
                        <div class="spinner-large"></div>
                        <p>Chargement des annonces...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(VM_Annonces.ErrorMessage))
                {
                    <div class="error-state">
                        <i class="bi bi-exclamation-circle"></i>
                        <p>@VM_Annonces.ErrorMessage</p>
                        <button class="btn-retry" @onclick="LoadAnnonces">Réessayer</button>
                    </div>
                }
                else if (VM_Annonces.Annonces == null || !VM_Annonces.Annonces.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-search"></i>
                        <p>Aucune annonce trouvée</p>
                    </div>
                }
                else
                {
                    <div class="product-grid">
                        @foreach (var annonce in VM_Annonces.Annonces)
                        {
                            <div class="product-card" @onclick="() => NavigateToProductDetail(annonce.AnnonceId)">
                                <div class="product-image-container">
                                    <div class="product-image"></div>
                                    <button class="wishlist-btn" @onclick:stopPropagation="true" @onclick="() => ToggleFavorite(annonce.AnnonceId)">
                                        <i class="bi bi-heart@(IsFavorite(annonce.AnnonceId) ? "-fill" : "")"></i>
                                    </button>
                                </div>

                                <div class="product-info">
                                    <h3 class="product-title">@annonce.Title</h3>

                                    <div class="product-meta">
                                        <span class="product-size">Taille @annonce.Taille</span>
                                        <span class="product-condition">@annonce.EtatArticle</span>
                                    </div>

                                    <div class="product-footer">
                                        <span class="product-price">@annonce.Prix€</span>
                                        <span class="product-seller">par @(@*annonce.NomVendeur ?? BESOIN DU NOM*@"Vendeur")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // Filter states
    private bool filterShirts = false;
    private bool filterPants = false;
    private bool filterDresses = false;
    private bool filterCoats = false;
    private bool filterShoes = false;

    private bool brandAdidas = false;
    private bool brandNike = false;
    private bool brandZara = false;
    private bool brandLevis = false;
    private bool brandOther = false;

    private bool sizeXL = false;
    private bool sizeS = false;
    private bool sizeM = false;
    private bool sizeL = false;
    private bool sizeXS = false;
    private bool sizeXXL = false;

    private int priceMax = 500;

    private bool conditionNew = false;
    private bool conditionVeryGood = false;
    private bool conditionGood = false;

    private HashSet<int> favoriteIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnonces();
    }

    private async Task LoadAnnonces()
    {
        await VM_Annonces.LoadActiveAnnoncesAsync();
    }

    private void NavigateToProductDetail(int? productId)
    {
        if (productId.HasValue)
        {
            navigationManager.NavigateTo($"/product/{productId}");
        }
    }

    private void ToggleFavorite(int? annonceId)
    {
        if (annonceId.HasValue)
        {
            if (favoriteIds.Contains(annonceId.Value))
            {
                favoriteIds.Remove(annonceId.Value);
            }
            else
            {
                favoriteIds.Add(annonceId.Value);
            }
            // TODO: Call API to save favorite
        }
    }

    private bool IsFavorite(int? annonceId)
    {
        return annonceId.HasValue && favoriteIds.Contains(annonceId.Value);
    }

    private void ResetFilters()
    {
        filterShirts = filterPants = filterDresses = filterCoats = filterShoes = false;
        brandAdidas = brandNike = brandZara = brandLevis = brandOther = false;
        sizeXL = sizeS = sizeM = sizeL = sizeXS = sizeXXL = false;
        priceMax = 500;
        conditionNew = conditionVeryGood = conditionGood = false;
    }

    private async Task ApplyFilters()
    {
        // TODO: Implement filter logic in VM_Annonces
        // await VM_Annonces.ApplyFiltersAsync(/* filter parameters */);
    }
}