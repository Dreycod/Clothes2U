@page "/moderation/signalements/{id:int}"
@rendermode InteractiveServer

<PageTitle>Détail du signalement - Modération</PageTitle>

<link rel="stylesheet" href="/css/moderation-shared.css" />


<div class="moderation-page">
    <div class="moderation-container">
        <!-- Sidebar -->
        <aside class="mod-sidebar">
            <div class="mod-header">
                <div class="mod-logo">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <h2>Clothes2U</h2>
                        <p>Moderation Board</p>
                    </div>
                </div>
            </div>

            <nav class="mod-nav">
                <a href="/moderation" class="mod-nav-item">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
                <a href="/moderation/signalements" class="mod-nav-item active">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>Signalements</span>
                </a>
                <a href="/moderation/images" class="mod-nav-item">
                    <i class="bi bi-image"></i>
                    <span>Images</span>
                </a>
                <a href="/moderation/restauration" class="mod-nav-item">
                    <i class="bi bi-person-check"></i>
                    <span>Restauration</span>
                </a>
                <a href="/moderation/sanctions" class="mod-nav-item">
                    <i class="bi bi-person-x"></i>
                    <span>Sanctions</span>
                </a>
                <a href="/moderation/mots-interdits" class="mod-nav-item">
                    <i class="bi bi-chat-square-text"></i>
                    <span>Mots interdits</span>
                </a>
                <a href="/moderation/support" class="mod-nav-item">
                    <i class="bi bi-chat-dots"></i>
                    <span>Support</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="mod-content">
            <div class="detail-container">
                <!-- Users Section -->
                <div class="users-section">
                    <!-- Reported User -->
                    <div class="user-card reported-user">
                        <div class="user-avatar"></div>
                        <div class="user-info">
                            <h3>Denielz Denielzzz</h3>
                            <p class="user-status">a été signalé pour <span class="status-highlight">Harcèlement</span></p>
                        </div>
                    </div>

                    <!-- Reporter User -->
                    <div class="user-card reporter-user">
                        <div class="user-avatar"></div>
                        <div class="user-info">
                            <h3>Marie Antoinette</h3>
                            <p class="user-status">utilisateur qui a signalé</p>
                        </div>
                    </div>
                </div>

                <!-- Messages Section -->
                <div class="messages-section">
                    <!-- Product Reference -->
                    <div class="product-reference">
                        <div class="product-thumb"></div>
                        <div>
                            <h4>T-shirt Adidas à revendre! Très bon état!</h4>
                            <p>20.99€</p>
                        </div>
                    </div>

                    <!-- Message Thread -->
                    <div class="message-thread">
                        <div class="message received">
                            <p>Bonjour, j'aime trop le t-shirt que vous vendez</p>
                            <span class="message-time">14:30</span>
                        </div>

                        <div class="message sent">
                            <p>Je vois, vous pouvez l'acheter.</p>
                            <span class="message-time">18:29</span>
                        </div>

                        <div class="message received">
                            <p>ah enfaite non, vous êtes bête hahahahahahahahahaha</p>
                            <span class="message-time">18:30</span>
                        </div>
                    </div>
                </div>

                <!-- Actions Section -->
                <div class="actions-section">
                    <h3>Actions de modération</h3>

                    <button class="action-btn warning" @onclick="SendWarning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Avertissement
                    </button>

                    <button class="action-btn suspend" @onclick="ShowSuspendModal">
                        <i class="bi bi-clock-history"></i>
                        Suspendre
                    </button>

                    <button class="action-btn ban" @onclick="ShowBanModal">
                        <i class="bi bi-x-circle"></i>
                        Bannir
                    </button>

                    <button class="action-btn dismiss" @onclick="DismissReport">
                        <i class="bi bi-check-circle"></i>
                        Ignorer le signalement
                    </button>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Suspend Modal -->
@if (showSuspendModal)
{
    <div class="modal-overlay" @onclick="() => showSuspendModal = false">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Suspendre le compte</h3>
            <p>Durée de la suspension:</p>

            <div class="duration-options">
                <button class="duration-btn" @onclick='() => suspendDuration = "1jour"'>1 jour</button>
                <button class="duration-btn" @onclick='() => suspendDuration = "3jours"'>3 jours</button>
                <button class="duration-btn" @onclick='() => suspendDuration = "1semaine"'>1 semaine</button>
                <button class="duration-btn" @onclick='() => suspendDuration = "1mois"'>1 mois</button>
            </div>

            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showSuspendModal = false">Annuler</button>
                <button class="btn-confirm" @onclick="ConfirmSuspend">Confirmer</button>
            </div>
        </div>
    </div>
}

<!-- Ban Modal -->
@if (showBanModal)
{
    <div class="modal-overlay" @onclick="() => showBanModal = false">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Bannir définitivement le compte</h3>
            <p>Cette action est irréversible. Êtes-vous sûr?</p>

            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showBanModal = false">Annuler</button>
                <button class="btn-confirm danger" @onclick="ConfirmBan">Bannir</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool showSuspendModal = false;
    private bool showBanModal = false;
    private string suspendDuration = string.Empty;

    private void SendWarning()
    {
        // TODO: Send warning to user
    }

    private void ShowSuspendModal()
    {
        showSuspendModal = true;
    }

    private void ShowBanModal()
    {
        showBanModal = true;
    }

    private void ConfirmSuspend()
    {
        // TODO: Suspend user for selected duration
        showSuspendModal = false;
    }

    private void ConfirmBan()
    {
        // TODO: Ban user permanently
        showBanModal = false;
    }

    private void DismissReport()
    {
        // TODO: Dismiss report and mark as resolved
    }
}