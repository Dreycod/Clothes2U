@page "/login"
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<PageTitle>Connexion - Clothes2U</PageTitle>

<div class="auth-container">
    <div class="auth-content">
        <!-- Logo and Tagline -->
        <div class="auth-header">
            <h1 class="auth-logo">Clothes<span class="logo-accent">2</span>U</h1>
            <p class="auth-tagline">Achetez et vendez des vêtements d'occasion</p>
        </div>

        <!-- Auth Card -->
        <div class="auth-card">
            <!-- Error/Success Messages -->
            @if (!string.IsNullOrEmpty(ConnexionVM.ErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@ConnexionVM.ErrorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(ConnexionVM.SuccessMessage))
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i>
                    <span>@ConnexionVM.SuccessMessage</span>
                </div>
            }

            <!-- Tab Navigation -->
            <div class="auth-tabs">
                <button class="auth-tab @(ConnexionVM.IsLoginMode ? "auth-tab-active" : "")" @onclick="ConnexionVM.ShowLogin">
                    Connexion
                </button>
                <button class="auth-tab @(!ConnexionVM.IsLoginMode ? "auth-tab-active" : "")" @onclick="ConnexionVM.ShowRegister">
                    Inscription
                </button>
            </div>

            <!-- Login Form -->
            @if (ConnexionVM.IsLoginMode)
            {
                <div class="auth-form">
                    <!-- Email Field -->
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <div class="input-with-icon">
                            <i class="bi bi-envelope input-icon"></i>
                            <input type="email" class="form-control" placeholder="votremail@example.com" @bind="ConnexionVM.LoginEmail" />
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label">Mot de passe</label>
                            <a href="/forgot-password" class="forgot-password">Mot de passe oublié?</a>
                        </div>
                        <div class="input-with-icon">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="@(ConnexionVM.ShowLoginPassword ? "text" : "password")" class="form-control" placeholder="••••••••••••" @bind="ConnexionVM.LoginPassword" />
                            <button type="button" class="password-toggle" @onclick="ConnexionVM.ToggleLoginPassword">
                                <i class="bi bi-eye@(ConnexionVM.ShowLoginPassword ? "-slash" : "")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="button" class="btn-submit" @onclick="ConnexionVM.HandleLogin" disabled="@ConnexionVM.IsLoading">
                        @if (ConnexionVM.IsLoading)
                        {
                            <span class="spinner"></span>
                            <span>Connexion en cours...</span>
                        }
                        else
                        {
                            <span>Se connecter</span>
                        }
                    </button>

                    <!-- Divider -->
                    <div class="divider">
                        <span>OU</span>
                    </div>

                    <!-- Google Button -->
                    <button type="button" class="btn-google" @onclick="ConnexionVM.HandleGoogleLogin">
                        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4" />
                            <path d="M9.003 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.96v2.332C2.44 15.983 5.485 18 9.003 18z" fill="#34A853" />
                            <path d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71 0-.593.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05" />
                            <path d="M9.003 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.464.891 11.426 0 9.003 0 5.485 0 2.44 2.017.96 4.958L3.967 7.29c.708-2.127 2.692-3.71 5.036-3.71z" fill="#EA4335" />
                        </svg>
                        Connectez-vous avec Google
                    </button>

                    <!-- Register Link -->
                    <div class="auth-footer">
                        <span>Pas encore de compte?</span>
                        <button type="button" class="auth-link-btn" @onclick="ConnexionVM.ShowRegister">S'inscrire</button>
                    </div>
                </div>
            }

            <!-- Register Form -->
            @if (!ConnexionVM.IsLoginMode)
            {
                <div class="auth-form">
                    <!-- Pseudo Field -->
                    <div class="form-group">
                        <label class="form-label">Pseudo</label>
                        <input type="text" class="form-control" placeholder="Un pseudo de votre choix" @bind="ConnexionVM.RegisterUsername"/>
                    </div>

                    <!-- Email Field -->
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <div class="input-with-icon">
                            <i class="bi bi-envelope input-icon"></i>
                            <input type="email" class="form-control" placeholder="votremail@example.com" @bind="ConnexionVM.RegisterEmail" />
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="form-group">
                        <label class="form-label">Mot de passe</label>
                        <div class="input-with-icon">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="@(ConnexionVM.ShowRegisterPassword ? "text" : "password")" class="form-control" placeholder="••••••••••••" @bind="ConnexionVM.RegisterPassword" />
                            <button type="button" class="password-toggle" @onclick="ConnexionVM.ToggleRegisterPassword">
                                <i class="bi bi-eye@(ConnexionVM.ShowRegisterPassword ? "-slash" : "")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="form-group">
                        <label class="form-label">Confirmer le mot de passe</label>
                        <div class="input-with-icon">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="@(ConnexionVM.ShowConfirmPassword ? "text" : "password")" class="form-control" placeholder="••••••••••••" @bind="ConnexionVM.RegisterConfirmPassword" />
                            <button type="button" class="password-toggle" @onclick="ConnexionVM.ToggleConfirmPassword">
                                <i class="bi bi-eye@(ConnexionVM.ShowConfirmPassword ? "-slash" : "")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Terms Checkbox -->
                    <div class="form-check-group">
                        <input type="checkbox" class="form-check-input" id="terms" @bind="ConnexionVM.AcceptTerms" />
                        <label class="form-check-label" for="terms">
                            J'accepte les <a href="#" class="terms-link">conditions d'utilisation</a> et la <a href="#" class="terms-link">politique de confidentialité</a>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button type="button" class="btn-submit" @onclick="ConnexionVM.HandleRegister" disabled="@ConnexionVM.IsLoading">
                        @if (ConnexionVM.IsLoading)
                        {
                            <span class="spinner"></span>
                            <span>Inscription en cours...</span>
                        }
                        else
                        {
                            <span>S'inscrire</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
</div>