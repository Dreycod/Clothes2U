@using Shared.DTO.Message

<div class="message-detail">
    <div class="section">
        <h3>Informations de l'utilisateur</h3>
        <div class="field-grid">
            <div class="field">
                <span class="label">Utilisateur ID:</span>
                <span class="value">@message.UserId</span>
            </div>
        </div>
    </div>

    <div class="section">
        <h3>Contenu du message</h3>
        <div class="field full-width">
            <div class="message-content">
                @message.content
            </div>
        </div>
    </div>

    <div class="section">
        <h3>Photos (@(message.Photos?.Count ?? 0))</h3>
        <div class="photos-grid">
            @if (message.Photos != null && message.Photos.Any())
            {
                @if (PhotosUrl != null && PhotosUrl.Any())
                {
                    foreach (string photoUrl in PhotosUrl)
                    {
                        <div class="photo-item">
                            <img src="@photoUrl" alt="Photo du message" />
                        </div>
                    }
                }
                else
                {
                    <div class="photos-loading">
                        <span>Chargement des photos...</span>
                    </div>
                }
            }
            else
            {
                <span>Aucune photo</span>
            }
        </div>
    </div>
</div>

<style>
    .message-detail {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .section {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .section h3 {
        margin: 0 0 15px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #ccc;
        font-size: 16px;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 10px;
    }

    .field {
        display: flex;
        padding: 8px;
        background: white;
        border-radius: 3px;
    }

    .field.full-width {
        grid-column: 1 / -1;
        display: block;
        padding: 0;
    }

    .label {
        font-weight: 600;
        margin-right: 8px;
        color: #555;
        min-width: 120px;
    }

    .value {
        color: #333;
        word-break: break-word;
    }

    .message-content {
        background: white;
        padding: 15px;
        border-radius: 3px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
        min-height: 100px;
        color: #333;
    }

    .photos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
    }

    .photo-item {
        position: relative;
        background: white;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid #ddd;
        transition: transform 0.2s;
    }

    .photo-item:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .photo-item img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .photos-loading {
        grid-column: 1 / -1;
        text-align: center;
        padding: 20px;
        color: #666;
        font-style: italic;
    }
</style>

@code {
    [Parameter]
    public MessageSignalementDTO message { get; set; }

    [Parameter] 
    public List<string> PhotosUrl { get; set; }
}