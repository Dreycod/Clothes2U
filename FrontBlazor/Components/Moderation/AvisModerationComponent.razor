<div class="note-detail">
    <div class="section">
        <h3>Informations principales</h3>
        <div class="field-grid">
            <div class="field">
                <span class="label">ID:</span>
                <span class="value">@note.NoteUtilisateurId</span>
            </div>
            <div class="field">
                <span class="label">Date:</span>
                <span class="value">@note.DatePublication.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
    </div>

    <div class="section">
        <h3>Note</h3>
        <div class="field-grid">
            <div class="field">
                <span class="label">Note:</span>
                <span class="value rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= note.Note ? "star filled" : "star empty")">★</span>
                    }
                    <span class="note-number">(@note.Note/5)</span>
                </span>
            </div>
        </div>
    </div>

    <div class="section">
        <h3>Utilisateurs</h3>
        <div class="field-grid">
            <div class="field">
                <span class="label">Auteur (Noteur):</span>
                <span class="value">@note.LoginAuteur</span>
            </div>
        </div>
    </div>

    <div class="section">
        <h3>Commentaire</h3>
        <div class="field full-width">
            <div class="value">
                @if (!string.IsNullOrWhiteSpace(note.Commentaire))
                {
                    <p class="commentaire">@note.Commentaire</p>
                }
                else
                {
                    <p class="no-comment">Aucun commentaire</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .note-detail {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .section {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .section h3 {
        margin: 0 0 15px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #ccc;
        font-size: 16px;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 10px;
    }

    .field {
        display: flex;
        padding: 8px;
        background: white;
        border-radius: 3px;
    }

    .field.full-width {
        grid-column: 1 / -1;
        display: block;
        padding: 10px;
    }

    .label {
        font-weight: 600;
        margin-right: 8px;
        color: #555;
        min-width: 150px;
    }

    .value {
        color: #333;
        word-break: break-word;
    }

    .rating {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .star {
        font-size: 20px;
    }

    .star.filled {
        color: #ffc107;
    }

    .star.empty {
        color: #ddd;
    }

    .note-number {
        margin-left: 8px;
        font-size: 14px;
        color: #666;
    }

    .commentaire {
        margin: 0;
        padding: 10px;
        background: white;
        border-radius: 3px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .no-comment {
        margin: 0;
        padding: 10px;
        color: #999;
        font-style: italic;
    }
</style>

@code {
    [Parameter]
    public NoteUtilisateur note { get; set; }
}