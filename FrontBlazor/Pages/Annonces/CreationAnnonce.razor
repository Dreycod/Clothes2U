@page "/add-article"
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Ajouter un article - Clothes2U</PageTitle>

<!-- Navigation Bar -->
<NavBar />

<div class="add-article-page">
    <div class="add-article-container">
        <!-- Photos Section -->
        <div class="photos-section">
            <h2 class="section-title">Photos de l'article</h2>
            <p class="section-subtitle">Ajoutez des photos montrer votre article</p>

            <div class="photo-upload-area">
                @if (uploadedPhotos.Any())
                {
                    <div class="uploaded-photos-grid">
                        @foreach (var photo in uploadedPhotos)
                        {
                            <div class="uploaded-photo">
                                <img src="@photo" alt="Photo" />
                                <button type="button" class="remove-photo-btn" @onclick="() => RemovePhoto(photo)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                        @if (uploadedPhotos.Count < 5)
                        {
                            <label class="add-more-btn">
                                <i class="bi bi-plus"></i>
                                <InputFile OnChange="HandlePhotoUpload"
                                           accept="image/jpeg,image/png,image/jpg"
                                           multiple
                                           style="display: none;" />
                            </label>
                        }
                    </div>
                }
                else
                {
                    <label class="upload-placeholder">
                        <i class="bi bi-upload"></i>
                        <span>Cliquez pour ajouter des photos</span>
                        <InputFile OnChange="HandlePhotoUpload"
                                   accept="image/jpeg,image/png,image/jpg"
                                   multiple
                                   style="display: none;" />
                    </label>
                }
            </div>
        </div>

        <!-- Article Information Section -->
        <div class="info-section">
            <h2 class="section-title">Informations sur l'article</h2>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label class="form-label">Nom de l'article</label>
                    <input type="text" class="form-input" placeholder="Ex: T-Shirt Adidas Vert" @bind="articleName" />
                </div>

                <div class="form-group">
                    <label class="form-label">Prix (€)</label>
                    <input type="number" class="form-input" placeholder="0" @bind="price" step="0.01" />
                </div>

                <div class="form-group">
                    <label class="form-label">Offre négotiable?</label>
                    <div class="checkbox-group">
                        <label class="checkbox-option">
                            <input type="checkbox" checked="@isNegotiable" @onchange="() => SetNegotiable(true)" />
                            <span>Oui</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" checked="@(!isNegotiable)" @onchange="() => SetNegotiable(false)" />
                            <span>Non</span>
                        </label>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label class="form-label">Description</label>
                    <textarea class="form-textarea" placeholder="Décrivez l'article, son état, usage, les détails, etc." @bind="description" rows="4"></textarea>
                </div>
            </div>
        </div>

        <!-- Brand Section -->
        <div class="brand-section">
            <h2 class="section-title">Marque</h2>

            @if (VM_Marque.IsLoading)
            {
                <div class="loading-inline">
                    <div class="spinner-small"></div>
                    <span>Chargement des marques...</span>
                </div>
            }
            else if (VM_Marque.Items != null && VM_Marque.Items.Any())
            {
                <div class="button-grid">
                    @foreach (Marque marque in VM_Marque.Items)
                    {
                        <button type="button"
                                class="category-btn @(selectedMarqueId == marque.MarqueId ? "active" : "")"
                                @onclick="() => selectedMarqueId = marque.MarqueId">
                            @marque.NomMarque
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="empty-message">Aucune marque disponible</p>
            }
        </div>

        <!-- Size & Color Section -->
        <div class="size-color-section">
            <h2 class="section-title">Taille & Couleur</h2>

            <div class="size-color-grid">
                <div class="size-group">
                    <label class="form-label">Taille</label>
                    @if (VM_Taille.IsLoading)
                    {
                        <div class="loading-inline">
                            <div class="spinner-small"></div>
                            <span>Chargement...</span>
                        </div>
                    }
                    else if (VM_Taille.Items != null && VM_Taille.Items.Any())
                    {
                        <div class="size-buttons">
                            @foreach (Taille taille in VM_Taille.Items)
                            {
                                <button type="button"
                                        class="size-btn @(selectedTailleId == taille.TailleId ? "active" : "")"
                                        @onclick="() => selectedTailleId = taille.TailleId">
                                    @taille.Libelletaille
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-message">Aucune taille disponible</p>
                    }
                </div>

                <div class="color-group">
                    <label class="form-label">Couleur</label>
                    @if (VM_Couleur.IsLoading)
                    {
                        <div class="loading-inline">Chargement...</div>
                    }
                    else if (VM_Couleur.Items != null && VM_Couleur.Items.Any())
                    {
                        <select class="form-input" @bind="selectedCouleurId">
                            <option value="0">-- Sélectionnez une couleur --</option>
                            @foreach (Couleur couleur in VM_Couleur.Items)
                            {
                                <option value="@couleur.CouleurId">@couleur.Nom</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-input" placeholder="Aucune couleur disponible" disabled />
                    }
                </div>
            </div>
        </div>

        <!-- Genre Section -->
        <div class="genre-section">
            <h2 class="section-title">Genre</h2>

            @if (VM_Genre.IsLoading)
            {
                <div class="loading-inline">
                    <div class="spinner-small"></div>
                    <span>Chargement...</span>
                </div>
            }
            else if (VM_Genre.Items != null && VM_Genre.Items.Any())
            {
                <div class="button-grid">
                    @foreach (Genre genre in VM_Genre.Items)
                    {
                        <button type="button"
                                class="category-btn @(selectedGenreId == genre.GenreId ? "active" : "")"
                                @onclick="() => selectedGenreId = genre.GenreId">
                            @genre.NomGenre
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="empty-message">Aucun genre disponible</p>
            }
        </div>

        <!-- Category & Condition Section -->
        <div class="category-section">
            <h2 class="section-title">Catégorie & État</h2>

            <div class="category-state-grid">
                <div class="category-group">
                    <label class="form-label">Catégorie</label>
                    @if (VM_Categorie.IsLoading)
                    {
                        <div class="loading-inline">
                            <div class="spinner-small"></div>
                            <span>Chargement...</span>
                        </div>
                    }
                    else if (VM_Categorie.Items != null && VM_Categorie.Items.Any())
                    {
                        <div class="button-grid">
                            @foreach (var categorie in VM_Categorie.Items)
                            {
                                <button type="button"
                                        class="category-btn @(selectedCategorieId == categorie.IdCategorie ? "active" : "")"
                                        @onclick="() => ToggleCategorieSelection(categorie.IdCategorie)">
                                    @categorie.LibelleCategorie
                                </button>
                            }
                        </div>

                        @* Show subcategories if a category is selected *@
                        @if (selectedCategorieId != 0)
                        {
                            var selectedCat = VM_Categorie.Items.FirstOrDefault(c => c.IdCategorie == selectedCategorieId);
                            if (selectedCat?.SousCategories != null && selectedCat.SousCategories.Any())
                            {
                                <div class="subcategory-section">
                                    <label class="form-label">Sous-catégorie</label>
                                    <div class="button-grid">
                                        @foreach (var sousCategorie in selectedCat.SousCategories)
                                        {
                                            <button type="button"
                                                    class="category-btn @(selectedSousCategorieId == sousCategorie.SousCategorieId ? "active" : "")"
                                                    @onclick="() => selectedSousCategorieId = sousCategorie.SousCategorieId">
                                                @sousCategorie.LibelleSousCategorie
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="empty-message">Aucune catégorie disponible</p>
                    }
                </div>

                <div class="state-group">
                    <label class="form-label">État de l'article</label>
                    <div class="button-grid-2col">
                        <button type="button"
                                class="state-btn @(selectedEtatArticleId == 1 ? "active" : "")"
                                @onclick='() => selectedEtatArticleId = 1'>
                            Neuf
                        </button>
                        <button type="button"
                                class="state-btn @(selectedEtatArticleId == 2 ? "active" : "")"
                                @onclick='() => selectedEtatArticleId = 2'>
                            Très bon état
                        </button>
                        <button type="button"
                                class="state-btn @(selectedEtatArticleId == 3 ? "active" : "")"
                                @onclick='() => selectedEtatArticleId = 3'>
                            Bon état
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Success/Error Message Section -->
        @if (ErrorMessages.Any())
        {
            <div class="alert alert-error">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    @foreach (var message in ErrorMessages)
                    {
                        <p>@message</p>
                    }
                </div>
            </div>
        }

        @if (HasCreated == true)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                <p>✅ L'article a été créé avec succès !</p>
            </div>
        }

        <!-- Action Buttons -->
        <div class="action-buttons">
            <button class="btn-cancel" @onclick="Cancel">Annuler</button>
            <button class="btn-submit" @onclick="PublishArticle">Publier l'article</button>
        </div>

    </div>
</div>

@code {

    [Inject]
    private IAuthService authService { get; set; } = default!;
    [Inject]
    private IMediasService<Photo> mediaService { get; set; } = default!;

    private Annonce newAnnonce = new Annonce();
    private List<string> uploadedPhotos = new();
    private List<string> ErrorMessages = new List<string>();
    bool? HasCreated = null;
    #region Variables
    // Properties that bind to UI and update newAnnonce
    private string articleName
    {
        get => newAnnonce.Title ?? string.Empty;
        set => newAnnonce.Title = value;
    }

    private decimal? price
    {
        get => newAnnonce.Prix == 0 ? null : newAnnonce.Prix;
        set => newAnnonce.Prix = value ?? 0;
    }

    private bool isNegotiable
    {
        get => newAnnonce.Negociable;
        set => newAnnonce.Negociable = value;
    }

    private string description
    {
        get => newAnnonce.Description ?? string.Empty;
        set => newAnnonce.Description = value;
    }

    private int selectedUtilisateurId
    {
        get => newAnnonce.UtilisateurId;
        set => newAnnonce.UtilisateurId = value;
    }

    private int? selectedMarqueId
    {
        get => newAnnonce.MarqueId;
        set => newAnnonce.MarqueId = value;
    }

    private int? selectedTailleId
    {
        get => newAnnonce.TailleId;
        set => newAnnonce.TailleId = value;
    }

    private int? selectedCouleurId
    {
        get => newAnnonce.CouleurId;
        set => newAnnonce.CouleurId = value;
    }

    private int? selectedGenreId
    {
        get => newAnnonce.GenreId;
        set => newAnnonce.GenreId = value;
    }

    private int? selectedCategorieId
    {
        get => newAnnonce.CategorieId;
        set => newAnnonce.CategorieId = value;
    }

    private int? selectedSousCategorieId
    {
        get => newAnnonce.SousCategorieId;
        set => newAnnonce.SousCategorieId = value;
    }

    private int? selectedEtatArticleId
    {
        get => newAnnonce.EtatId;
        set => newAnnonce.EtatId = value;
    }
    #endregion

    protected override async Task OnInitializedAsync()
    {
        await VM_Marque.LoadAsync();
        await VM_Taille.LoadAsync();
        await VM_Couleur.LoadAsync();
        await VM_Categorie.LoadAsync();
        await VM_Genre.LoadAsync();

        // Load existing annonce from state service if available
        var existingAnnonce = annonceStateService.GetEntity();
        if (existingAnnonce != null)
        {
            newAnnonce = existingAnnonce;
            // Photos will automatically populate through uploadedPhotos if needed
        }
    }

    private void SetNegotiable(bool value)
    {
        isNegotiable = value;
    }

    private void ToggleCategorieSelection(int categoryId)
    {
        selectedCategorieId = categoryId;
        selectedSousCategorieId = 0; // Reset subcategory when changing category
    }
    #region Photo Methods
    private async Task HandlePhotoUpload(InputFileChangeEventArgs e)
    {
        const long maxFileSize = 5 * 1024 * 1024; // 5 MB
        const int maxAllowedFiles = 5;
        const int maxWidth = 1920;
        const int maxHeight = 1920;

        foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
        {
            if (uploadedPhotos.Count >= maxAllowedFiles)
            {
                ErrorMessages.Add($"Maximum {maxAllowedFiles} photos autorisées");
                break;
            }

            try
            {
                // Vérifier la taille
                if (file.Size > maxFileSize)
                {
                    ErrorMessages.Add($"{file.Name} est trop volumineux (max 5MB)");
                    continue;
                }

                // Vérifier le type
                if (!file.ContentType.StartsWith("image/"))
                {
                    ErrorMessages.Add($"{file.Name} n'est pas une image valide");
                    continue;
                }

                // Redimensionner l'image si elle est trop grande
                var resizedImage = await file.RequestImageFileAsync(file.ContentType, maxWidth, maxHeight);

                // Lire le fichier redimensionné
                using var stream = resizedImage.OpenReadStream(maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                if (bytes.Length == 0)
                {
                    ErrorMessages.Add($"{file.Name} est vide");
                    continue;
                }

                var base64 = Convert.ToBase64String(bytes);
                var dataUrl = $"data:{file.ContentType};base64,{base64}";

                uploadedPhotos.Add(dataUrl);

                Console.WriteLine($"✅ Photo ajoutée et redimensionnée: {file.Name} ({bytes.Length} bytes)");
            }
            catch (Exception ex)
            {
                ErrorMessages.Add($"Erreur lors du chargement de {file.Name}: {ex.Message}");
                Console.WriteLine($"❌ Erreur HandlePhotoUpload: {ex.Message}");
                Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");
            }
        }

        StateHasChanged();
    }

    private void RemovePhoto(string photo)
    {
        uploadedPhotos.Remove(photo);
    }
    #endregion

    private void SaveAnnonce()
    {
        newAnnonce.DateAnnonce = DateTime.Now;
        annonceStateService.SetEntity(newAnnonce);
    }

    private List<string> ValidateAnnonce()
    {
        List<string> errorMessages = new List<string>();

        if (string.IsNullOrWhiteSpace(newAnnonce.Title))
            errorMessages.Add("Le nom de l'article est obligatoire");

        if (string.IsNullOrWhiteSpace(newAnnonce.Description))
            errorMessages.Add("La description est obligatoire");

        if (newAnnonce.Prix <= 0)
            errorMessages.Add("Le prix doit être supérieur à 0");

        if (!newAnnonce.MarqueId.HasValue || newAnnonce.MarqueId == 0)
            errorMessages.Add("Veuillez sélectionner une marque");

        if (!newAnnonce.TailleId.HasValue || newAnnonce.TailleId == 0)
            errorMessages.Add("Veuillez sélectionner une taille");

        if (!newAnnonce.CouleurId.HasValue || newAnnonce.CouleurId == 0)
            errorMessages.Add("Veuillez sélectionner une couleur");

        if (!newAnnonce.GenreId.HasValue || newAnnonce.GenreId == 0)
            errorMessages.Add("Veuillez sélectionner un genre");

        if (!newAnnonce.EtatId.HasValue)
            errorMessages.Add("Veuillez sélectionner l'état de l'article");

        if (!newAnnonce.CategorieId.HasValue || newAnnonce.CategorieId == 0)
            errorMessages.Add("Veuillez sélectionner une catégorie");

        return errorMessages;
    }

    private void PrintAnnonceDetails()
    {
        Console.WriteLine("Annonce Details:");
        Console.WriteLine($"Title: {newAnnonce.Title}");
        Console.WriteLine($"Price: {newAnnonce.Prix}");
        Console.WriteLine($"Negotiable: {newAnnonce.Negociable}");
        Console.WriteLine($"Brand ID: {newAnnonce.MarqueId}");
        Console.WriteLine($"Size ID: {newAnnonce.TailleId}");
        Console.WriteLine($"Color ID: {newAnnonce.CouleurId}");
        Console.WriteLine($"Genre ID: {newAnnonce.GenreId}");
        Console.WriteLine($"Category ID: {newAnnonce.CategorieId}");
        Console.WriteLine($"Subcategory ID: {newAnnonce.SousCategorieId}");
        Console.WriteLine($"State ID: {newAnnonce.EtatId}");
        Console.WriteLine($"User ID: {newAnnonce.UtilisateurId}");
    }

    private async Task PublishArticle()
    {
        ErrorMessages.Clear();
        HasCreated = null;

        List<string> errorMessages = ValidateAnnonce();

        if (errorMessages.Any())
        {
            HasCreated = false;
            ErrorMessages = errorMessages;
            StateHasChanged();
            return;
        }

        // Récupère l'utilisateur connecté
        var currentUser = await authService.GetCurrentUserAsync();
        if (currentUser == null)
        {
            ErrorMessages.Add("Vous devez être connecté pour créer une annonce");
            HasCreated = false;
            StateHasChanged();
            return;
        }

        newAnnonce.UtilisateurId = currentUser.UtilisateurId;
        newAnnonce.DateAnnonce = DateTime.UtcNow;
        newAnnonce.StatutAnnonceId = 1;

        // Créer l'annonce et récupérer l'ID
        var createdAnnonce = await VM_CreationAnnonce.CreateAnnonceAsync(newAnnonce);

        if (createdAnnonce == null)
        {
            ErrorMessages.Add("L'annonce n'a pas pu être créée. Erreur API.");
            HasCreated = false;
            StateHasChanged();
            return;
        }

        // Mettre à jour newAnnonce avec l'annonce créée
        newAnnonce = createdAnnonce;

        Console.WriteLine($"✅ Annonce créée avec l'ID: {newAnnonce.AnnonceId}");

        // Uploader les photos si disponibles
        if (uploadedPhotos.Any())
        {
            Console.WriteLine($"🔄 Upload de {uploadedPhotos.Count} photos pour l'annonce {newAnnonce.AnnonceId}");

            bool uploadSuccess = await mediaService.UploadMultiplePhotosAnnonceAsync(
                newAnnonce.AnnonceId,
                uploadedPhotos
            );

            if (!uploadSuccess)
            {
                ErrorMessages.Add("⚠️ L'annonce a été créée mais certaines photos n'ont pas pu être uploadées.");
            }
            else
            {
                Console.WriteLine($"✅ Toutes les photos ont été uploadées avec succès");
            }
        }

        HasCreated = true;
        await Task.Delay(2000);
        navigationManager.NavigateTo($"/profile/{currentUser.Login}");
        StateHasChanged();
    }

    private void Cancel()
    {
        // Save the current state even when canceling
        SaveAnnonce();

        navigationManager.NavigateTo("/");
    }
}