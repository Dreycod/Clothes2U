    // Filtrer les marques selon la recherche (ordre alphabétique)
    private IEnumerable<MarqueDTO> GetFilteredMarques()
    {
        if (VM_CreationAnnonce.Marques == null)
            return Enumerable.Empty<MarqueDTO>();

        var filtered = VM_CreationAnnonce.Marques.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(marqueSearch))
        {
            filtered = filtered.Where(m =>
                m.NomMarque.Contains(marqueSearch, StringComparison.OrdinalIgnoreCase)
            );
        }

        return filtered.OrderBy(m => m.NomMarque);
    }

    // Filtrer les tailles selon la catégorie sélectionnée
    private IEnumerable<TailleDTO>? GetFilteredTailles()
    {
        if (VM_CreationAnnonce.Tailles == null || VM_CreationAnnonce.NewAnnonce.SousCategorieId == 0)
            return null;

        // ✅ Filtrer selon les tailles disponibles pour cette catégorie
        if (!VM_CreationAnnonce.AvailableTailleIds.Any())
            return null;

        return VM_CreationAnnonce.Tailles
            .Where(t => VM_CreationAnnonce.AvailableTailleIds.Contains(t.TailleId))
            .OrderBy(t => t.Libelletaille);
    }
}
