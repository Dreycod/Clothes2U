@page "/add-article"
@using Microsoft.AspNetCore.Components.Forms
@inject CreationAnnonceViewModel VM_CreationAnnonce
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Ajouter un article - Clothes2U</PageTitle>

<NavBar />

<div class="add-article-page">
    <div class="add-article-container">

        <!-- ============================================ -->
        <!-- SECTION 1: PHOTOS -->
        <!-- ============================================ -->
        <div class="form-section photos-section">
            <h2 class="section-title">Photos de l'article</h2>
            <p class="section-subtitle">Ajoutez jusqu'à 5 photos pour montrer votre article</p>

            <div class="photo-upload-area">
                @if (VM_CreationAnnonce.SelectedFilePreviews.Any())
                {
                    <div class="uploaded-photos-grid">
                        @for (int i = 0; i < VM_CreationAnnonce.SelectedFilePreviews.Count; i++)
                        {
                            var index = i;
                            <div class="uploaded-photo">
                                <img src="@VM_CreationAnnonce.SelectedFilePreviews[i].PreviewBase64" alt="Photo" />
                                <button type="button"
                                        class="remove-photo-btn"
                                        @onclick="() => RemovePhoto(index)"
                                        @onclick:preventDefault="true"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                        @if (VM_CreationAnnonce.SelectedFilePreviews.Count < 5)
                        {
                            <label class="add-more-btn">
                                <i class="bi bi-plus"></i>
                                <InputFile OnChange="OnPhotosSelected"
                                           accept="image/*"
                                           multiple
                                           style="display: none;" />
                            </label>
                        }
                    </div>
                }
                else
                {
                    <label class="upload-placeholder">
                        <i class="bi bi-upload"></i>
                        <span>Cliquez pour ajouter des photos</span>
                        <InputFile OnChange="OnPhotosSelected"
                                   accept="image/*"
                                   multiple
                                   style="display: none;" />
                    </label>
                }
            </div>
        </div>

        <!-- ============================================ -->
        <!-- SECTION 2: INFORMATIONS DE L'ARTICLE -->
        <!-- ============================================ -->
        <div class="form-section info-section">
            <h2 class="section-title">Informations sur l'article</h2>

            <div class="form-grid">
                <!-- Nom de l'article -->
                <div class="form-group full-width">
                    <label class="form-label">Nom de l'article *</label>
                    <input type="text"
                           class="form-input"
                           placeholder="Ex: T-Shirt Adidas Vert"
                           @bind="VM_CreationAnnonce.NewAnnonce.Titre" />
                </div>

                <!-- Prix -->
                <div class="form-group">
                    <label class="form-label">Prix (€) *</label>
                    <input type="number"
                           class="form-input"
                           placeholder="0.00"
                           @bind="VM_CreationAnnonce.NewAnnonce.Prix"
                           step="0.01"
                           min="0" />
                </div>

                <!-- Négociable - Toggle Switch -->
                <div class="form-group">
                    <label class="form-label">Offre négociable?</label>
                    <div class="toggle-switch-container">
                        <button type="button"
                                class="toggle-switch @(VM_CreationAnnonce.NewAnnonce.EstNegociable ? "active" : "")"
                                @onclick="() => VM_CreationAnnonce.NewAnnonce.EstNegociable = !VM_CreationAnnonce.NewAnnonce.EstNegociable">
                            <span class="toggle-option @(VM_CreationAnnonce.NewAnnonce.EstNegociable ? "" : "selected")">Non</span>
                            <span class="toggle-slider"></span>
                            <span class="toggle-option @(VM_CreationAnnonce.NewAnnonce.EstNegociable ? "selected" : "")">Oui</span>
                        </button>
                    </div>
                </div>

                <!-- Description -->
                <div class="form-group full-width">
                    <label class="form-label">Description *</label>
                    <textarea class="form-textarea"
                              placeholder="Décrivez l'article, son état, usage, les détails, etc."
                              @bind="VM_CreationAnnonce.NewAnnonce.Description"
                              rows="4"></textarea>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- SECTION 3: GENRE -->
        <!-- ============================================ -->
        <div class="form-section genre-section">
            <h2 class="section-title">Genre *</h2>

            @if (VM_CreationAnnonce.IsLoading)
            {
                <div class="loading-inline">
                    <div class="spinner-small"></div>
                    <span>Chargement...</span>
                </div>
            }
            else if (VM_CreationAnnonce.Genres?.Any() == true)
            {
                <div class="button-grid-3">
                    @foreach (var genre in VM_CreationAnnonce.Genres)
                    {
                        <button type="button"
                                class="selection-btn @(VM_CreationAnnonce.NewAnnonce.GenreId == genre.GenreId ? "active" : "")"
                                @onclick="() => VM_CreationAnnonce.NewAnnonce.GenreId = genre.GenreId">
                            @genre.NomGenre
                        </button>
                    }
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- SECTION 4: MARQUE (avec recherche) -->
        <!-- ============================================ -->
        <div class="form-section brand-section">
            <h2 class="section-title">Marque *</h2>

            @if (VM_CreationAnnonce.IsLoading)
            {
                <div class="loading-inline">
                    <div class="spinner-small"></div>
                    <span>Chargement...</span>
                </div>
            }
            else if (VM_CreationAnnonce.Marques?.Any() == true)
            {
                <!-- Barre de recherche -->
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           class="search-input"
                           placeholder="Rechercher une marque..."
                           @bind="marqueSearch"
                           @bind:event="oninput" />
                </div>

                <!-- Liste des marques filtrées -->
                <div class="marque-list">
                    @foreach (var marque in GetFilteredMarques())
                    {
                        <button type="button"
                                class="marque-item @(VM_CreationAnnonce.NewAnnonce.MarqueId == marque.MarqueID ? "active" : "")"
                                @onclick="() => VM_CreationAnnonce.NewAnnonce.MarqueId = marque.MarqueID">
                            @marque.NomMarque
                        </button>
                    }
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- SECTION 5: CATÉGORIE & ÉTAT -->
        <!-- ============================================ -->
        <div class="form-section category-section">
            <h2 class="section-title">Catégorie & État</h2>

            <div class="category-state-grid">
                <!-- Catégorie -->
                <div class="category-group">
                    <label class="form-label">Catégorie *</label>
                    @if (VM_CreationAnnonce.IsLoading)
                    {
                        <div class="loading-inline">
                            <div class="spinner-small"></div>
                            <span>Chargement...</span>
                        </div>
                    }
                    else if (VM_CreationAnnonce.Categories?.Any() == true)
                    {
                        <div class="button-grid-2">
                            @foreach (var categorie in VM_CreationAnnonce.Categories)
                            {
                                <button type="button"
                                        class="selection-btn @(VM_CreationAnnonce.NewAnnonce.CategorieId == categorie.IdCategorie ? "active" : "")"
                                        @onclick="() => OnCategorieSelected(categorie.IdCategorie)">
                                    @categorie.LibelleCategorie
                                </button>
                            }
                        </div>

                        <!-- Sous-catégories -->
                        @if (VM_CreationAnnonce.NewAnnonce.CategorieId != 0)
                        {
                            var selectedCat = VM_CreationAnnonce.Categories.FirstOrDefault(c => c.IdCategorie == VM_CreationAnnonce.NewAnnonce.CategorieId);
                            if (selectedCat?.SousCategories?.Any() == true)
                            {
                                <div class="subcategory-section">
                                    <label class="form-label">Sous-catégorie *</label>
                                    <div class="button-grid-2">
                                        @foreach (var sousCategorie in selectedCat.SousCategories)
                                        {
                                            <button type="button"
                                                    class="selection-btn @(VM_CreationAnnonce.NewAnnonce.SousCategorieId == sousCategorie.SousCategorieId ? "active" : "")"
                                                    @onclick="() => OnSousCategorieSelected(sousCategorie.SousCategorieId)">
                                                @sousCategorie.LibelleSousCategorie
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- État de l'article -->
                <div class="state-group">
                    <label class="form-label">État de l'article *</label>
                    @if (VM_CreationAnnonce.IsLoading)
                    {
                        <div class="loading-inline">
                            <div class="spinner-small"></div>
                            <span>Chargement...</span>
                        </div>
                    }
                    else if (VM_CreationAnnonce.Etats?.Any() == true)
                    {
                        <div class="state-buttons">
                            @foreach (var etat in VM_CreationAnnonce.Etats)
                            {
                                <button type="button"
                                        class="state-btn @(VM_CreationAnnonce.NewAnnonce.EtatId == etat.EtatArticleId ? "active" : "")"
                                        @onclick="() => VM_CreationAnnonce.NewAnnonce.EtatId = etat.EtatArticleId">
                                    @etat.NomEtat
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- SECTION 6: TAILLE (dépend de la catégorie) -->
        <!-- ============================================ -->
        <div class="form-section size-section">
            <h2 class="section-title">Taille *</h2>

            @if (VM_CreationAnnonce.NewAnnonce.SousCategorieId == 0)
            {
                <p class="info-message">
                    <i class="bi bi-info-circle"></i>
                    Veuillez d'abord sélectionner une catégorie
                </p>
            }
            else if (VM_CreationAnnonce.IsLoading)
            {
                <div class="loading-inline">
                    <div class="spinner-small"></div>
                    <span>Chargement...</span>
                </div>
            }
            else if (GetFilteredTailles()?.Any() == true)
            {
                <div class="size-buttons">
                    @foreach (var taille in GetFilteredTailles())
                    {
                        <button type="button"
                                class="size-btn @(VM_CreationAnnonce.NewAnnonce.TailleId == taille.TailleId ? "active" : "")"
                                @onclick="() => VM_CreationAnnonce.NewAnnonce.TailleId = taille.TailleId">
                            @taille.Libelletaille
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="info-message">
                    <i class="bi bi-info-circle"></i>
                    Aucune taille disponible pour cette catégorie
                </p>
            }
        </div>

        <!-- ============================================ -->
        <!-- SECTION 7: COULEURS (multi-sélection) -->
        <!-- ============================================ -->
        <div class="form-section color-section">
            <h2 class="section-title">Couleur(s) *</h2>
            <p class="section-subtitle">Sélectionnez une ou plusieurs couleurs</p>

            @if (VM_CreationAnnonce.IsLoading)
            {
                <div class="loading-inline">
                    <div class="spinner-small"></div>
                    <span>Chargement...</span>
                </div>
            }
            else if (VM_CreationAnnonce.Couleurs?.Any() == true)
            {
                <div class="color-grid">
                    @foreach (var couleur in VM_CreationAnnonce.Couleurs)
                    {
                        <label class="color-checkbox @(VM_CreationAnnonce.IsCouleurSelected(couleur.CouleurId) ? "active" : "")">
                            <input type="checkbox"
                                   checked="@VM_CreationAnnonce.IsCouleurSelected(couleur.CouleurId)"
                                   @onchange="() => VM_CreationAnnonce.ToggleCouleur(couleur.CouleurId)"
                                   style="display: none;" />
                            <span class="color-name">@couleur.Nom</span>
                            <i class="bi bi-check-circle-fill"></i>
                        </label>
                    }
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- MESSAGES D'ERREUR -->
        <!-- ============================================ -->
        @if (VM_CreationAnnonce.ErrorMessages.Any())
        {
            <div class="alert alert-error">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    <strong>Erreurs de validation:</strong>
                    <ul>
                        @foreach (var message in VM_CreationAnnonce.ErrorMessages)
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (VM_CreationAnnonce.HasCreated == true)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                <p>✅ L'article a été créé avec succès ! Redirection...</p>
            </div>
        }

        <!-- ============================================ -->
        <!-- BOUTONS D'ACTION -->
        <!-- ============================================ -->
        <div class="action-buttons">
            <button class="btn-cancel"
                    @onclick="OnCancel"
                    disabled="@(VM_CreationAnnonce.IsLoading || VM_CreationAnnonce.IsUploadingPhotos)">
                Annuler
            </button>

            <button class="btn-submit"
                    @onclick="OnPublishClick"
                    disabled="@(VM_CreationAnnonce.IsLoading || VM_CreationAnnonce.IsUploadingPhotos)">
                @if (VM_CreationAnnonce.IsLoading)
                {
                    <span class="spinner-small-inline"></span>
                    <span>Publication...</span>
                }
                else if (VM_CreationAnnonce.IsUploadingPhotos)
                {
                    <span class="spinner-small-inline"></span>
                    <span>Upload des photos...</span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i>
                    <span>Publier l'article</span>
                }
            </button>
        </div>

    </div>
</div>

<Footer />

@code {
    private string marqueSearch = "";

    protected override async Task OnInitializedAsync()
    {
        await VM_CreationAnnonce.LoadAsync();
        VM_CreationAnnonce.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        VM_CreationAnnonce.OnChange -= StateHasChanged;
    }

    // ✅ EXACTEMENT comme Messages.razor
    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        await VM_CreationAnnonce.OnImagesSelectedAsync(e);
    }

    // ✅ EXACTEMENT comme Messages.razor
    private void RemovePhoto(int index)
    {
        Console.WriteLine($"[Page] 🗑️ Removing photo at index {index}");
        VM_CreationAnnonce.RemoveSelectedPhotoAt(index);
    }

    private void OnCategorieSelected(int categorieId)
    {
        VM_CreationAnnonce.NewAnnonce.CategorieId = categorieId;
        VM_CreationAnnonce.NewAnnonce.SousCategorieId = 0;

        // ✅ Mettre à jour les tailles disponibles
        VM_CreationAnnonce.UpdateAvailableTailles(categorieId);

        StateHasChanged();
    }

    private void OnSousCategorieSelected(int sousCategorieId)
    {
        VM_CreationAnnonce.NewAnnonce.SousCategorieId = sousCategorieId;
        StateHasChanged();
    }

    private async Task OnPublishClick()
    {
        await VM_CreationAnnonce.PublishAnnonceAsync();
    }

    private void OnCancel()
    {
        Navigation.NavigateTo("/");
    }

    // Filtrer les marques selon la recherche (ordre alphabétique)
    private IEnumerable<MarqueDTO> GetFilteredMarques()
    {
        if (VM_CreationAnnonce.Marques == null)
            return Enumerable.Empty<MarqueDTO>();

        var filtered = VM_CreationAnnonce.Marques.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(marqueSearch))
        {
            filtered = filtered.Where(m =>
                m.NomMarque.Contains(marqueSearch, StringComparison.OrdinalIgnoreCase)
            );
        }

        return filtered.OrderBy(m => m.NomMarque);
    }

    // Filtrer les tailles selon la catégorie sélectionnée
    private IEnumerable<TailleDTO>? GetFilteredTailles()
    {
        if (VM_CreationAnnonce.Tailles == null || VM_CreationAnnonce.NewAnnonce.SousCategorieId == 0)
            return null;

        // ✅ Filtrer selon les tailles disponibles pour cette catégorie
        if (!VM_CreationAnnonce.AvailableTailleIds.Any())
            return null;

        return VM_CreationAnnonce.Tailles
            .Where(t => VM_CreationAnnonce.AvailableTailleIds.Contains(t.TailleId))
            .OrderBy(t => t.Libelletaille);
    }
}