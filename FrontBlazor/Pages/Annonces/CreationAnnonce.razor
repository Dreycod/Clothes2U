    private void SaveAnnonce()
    {
        newAnnonce.DateAnnonce = DateTime.Now;
        annonceStateService.SetEntity(newAnnonce);
    }

    private List<string> ValidateAnnonce()
    {
        List<string> errorMessages = new List<string>();

        // Add validation checks with corresponding error messages
        if (string.IsNullOrWhiteSpace(newAnnonce.Title))
            errorMessages.Add("Error: Article name is required");

        if (newAnnonce.Prix <= 0)
            errorMessages.Add("Error: Valid price is required");

        if (newAnnonce.MarqueId == 0)
            errorMessages.Add("Error: Please select a brand");

        if (newAnnonce.TailleId == 0)
            errorMessages.Add("Error: Please select a size");

        if (newAnnonce.CouleurId == 0)
            errorMessages.Add("Error: Please select a color");

        if (newAnnonce.EtatId == 0)
            errorMessages.Add("Error: Please select a state");

        if (newAnnonce.CategorieId == 0)
            errorMessages.Add("Error: Please select a category");

        return errorMessages;
    }

    private void PrintAnnonceDetails()
    {
        Console.WriteLine("Annonce Details:");
        Console.WriteLine($"Title: {newAnnonce.Title}");
        Console.WriteLine($"Price: {newAnnonce.Prix}");
        Console.WriteLine($"Negotiable: {newAnnonce.Negociable}");
        Console.WriteLine($"Brand ID: {newAnnonce.MarqueId}");
        Console.WriteLine($"Size ID: {newAnnonce.TailleId}");
        Console.WriteLine($"Color ID: {newAnnonce.CouleurId}");
        Console.WriteLine($"Category ID: {newAnnonce.CategorieId}");
        Console.WriteLine($"Subcategory ID: {newAnnonce.SousCategorieId}");
        Console.WriteLine($"State ID: {newAnnonce.EtatId}");
        Console.WriteLine($"User ID: {newAnnonce.UtilisateurId}");
    }

    private async Task PublishArticle() 
    {
        ErrorMessages.Clear();

        List<string> errorMessages = ValidateAnnonce();

        if (ErrorMessages.Any())
        {
            HasCreated = false;
            ErrorMessages = errorMessages;
            StateHasChanged();
            return;
        }

        // Save the annonce
        bool result = await VM_CreationAnnonce.CreateAnnonceAsync(newAnnonce);
        if (result == false ) 
            ErrorMessages.Add("Product was not created due to API problems");
        HasCreated = result;
        //Console.WriteLine($"Annonce creation result: {result}");

        PrintAnnonceDetails();
        // Navigate back after publishing
        StateHasChanged();
    }

    private void Cancel()
    {
        // Save the current state even when canceling
        SaveAnnonce();

        navigationManager.NavigateTo("/");
    }
