@page "/search"
@using FrontBlazor.ViewModel.Generic
@using Microsoft.AspNetCore.WebUtilities
@inject SearchAnnonceViewModel VM_Search
@layout ClientLayout
@implements IDisposable

<PageTitle>Rechercher - Clothes2U</PageTitle>

<NavBar />

<div class="search-page">
    <div class="search-container">
        <div class="search-header">
            <div>
                <h1 class="search-title">Rechercher des articles</h1>
                <p class="search-subtitle">
                    Paramétrez le filtre pour trouver ce qui vous intéresse le plus
                </p>
            </div>
        </div>

        <div class="search-content">
            <aside class="filters-sidebar">
                <div class="filters-header">
                    <h3>Filtres</h3>
                    <button class="reset-btn" @onclick="VM_Search.ResetFilters">Réinitialiser</button>
                </div>

                <!-- Genre -->
                <div class="filter-section">
                    <h4 class="filter-title">Genre</h4>
                    <div class="filter-options">
                        @if (VM_Search.IsLoading)
                        {
                            <div class="filter-loading">
                                <div class="spinner-small"></div>
                                <span>Chargement...</span>
                            </div>
                        }
                        else if (VM_Search.Genres != null && VM_Search.Genres.Any())
                        {
                            @foreach (var genre in VM_Search.Genres)
                            {
                                <label class="checkbox-label">
                                    <input type="checkbox"
                                           checked="@VM_Search.SelectedGenres.Contains(genre.NomGenre)"
                                           @onchange="() => VM_Search.ToggleFilter(VM_Search.SelectedGenres, genre.NomGenre)" />
                                    <span>@genre.NomGenre</span>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="filter-empty">Aucun genre disponible</p>
                        }
                    </div>
                </div>
                <div class="filter-section">
                    <h4 class="filter-title">Type de vêtement</h4>
                    <div class="filter-options">
                        @if (VM_Search.IsLoading)
                        {
                            <div class="filter-loading">
                                <div class="spinner-small"></div>
                                <span>Chargement...</span>
                            </div>
                        }
                        else if (VM_Search.Categories != null && VM_Search.Categories.Any())
                        {
                            @foreach (var categorie in VM_Search.Categories)
                            {
                                <div class="category-filter-item">
                                    <div class="category-header" @onclick="() => VM_Search.ToggleCategory(categorie.IdCategorie)">
                                        <label class="checkbox-label">
                                            <input type="checkbox"
                                                   checked="@VM_Search.SelectedCategories.Contains(categorie.LibelleCategorie)"
                                                   @onclick:stopPropagation
                                                   @onchange="() => VM_Search.ToggleFilter(VM_Search.SelectedCategories, categorie.LibelleCategorie)" />
                                            <span>@categorie.LibelleCategorie</span>
                                        </label>
                                        @if (categorie.SousCategories != null && categorie.SousCategories.Any())
                                        {
                                            <i class="bi bi-chevron-@(VM_Search.ExpandedCategories.Contains(categorie.IdCategorie) ? "up" : "down") expand-icon"></i>
                                        }
                                    </div>

                                    @if (VM_Search.ExpandedCategories.Contains(categorie.IdCategorie) &&
                                         categorie.SousCategories != null &&
                                         categorie.SousCategories.Any())
                                    {
                                        <div class="subcategory-list">
                                            @foreach (var sousCategorie in categorie.SousCategories)
                                            {
                                                <label class="checkbox-label subcategory-item">
                                                    <input type="checkbox"
                                                           checked="@VM_Search.SelectedSousCategories.Contains(sousCategorie.LibelleSousCategorie!)"
                                                           @onchange="() => VM_Search.ToggleFilter(VM_Search.SelectedSousCategories, sousCategorie.LibelleSousCategorie!)" />
                                                    <span>@sousCategorie.LibelleSousCategorie</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="filter-empty">Aucune catégorie disponible</p>
                        }
                    </div>
                </div>

                <!-- Marque -->
                <div class="filter-section">
                    <h4 class="filter-title">Marque</h4>
                    <div class="filter-options">
                        <div class="search-box">
                            <input type="text"
                                   class="search-input"
                                   placeholder="Rechercher une marque..."
                                   @bind="VM_Search.marqueSearch"
                                   @bind:event="oninput"
                                   @bind:after="@VM_Search.GetFilteredMarques"
                                   @onkeydown="@VM_Search.GetFilteredMarques"/>
                        </div>
                        @if (VM_Search.IsLoading)
                        {
                            <div class="filter-loading">
                                <div class="spinner-small"></div>
                                <span>Chargement...</span>
                            </div>
                        }
                        else if (VM_Search.Marques != null && VM_Search.Marques.Any())
                        {

                            @foreach (var marque in VM_Search.Marques)
                            {
                                <label class="checkbox-label">
                                    <input type="checkbox"
                                           checked="@VM_Search.SelectedMarques.Contains(marque.NomMarque)"
                                           @onchange="() => VM_Search.ToggleFilter(VM_Search.SelectedMarques, marque.NomMarque)"/>
                                    <span>@marque.NomMarque</span>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="filter-empty">Aucune marque disponible</p>
                        }
                    </div>
                </div>

                <!-- Taille -->
                <div class="filter-section">
                    <h4 class="filter-title">Taille</h4>
                    @if (VM_Search.IsLoading)
                    {
                        <div class="filter-loading">
                            <div class="spinner-small"></div>
                            <span>Chargement...</span>
                        </div>
                    }
                    else if (VM_Search.Tailles != null && VM_Search.Tailles.Any())
                    {
                        <div class="size-buttons">
                            @foreach (var taille in VM_Search.Tailles)
                            {
                                <button type="button"
                                        class="size-btn @(VM_Search.SelectedTailles.Contains(taille.Libelletaille) ? "active" : "")"
                                        @onclick="() => VM_Search.ToggleFilter(VM_Search.SelectedTailles, taille.Libelletaille)">
                                    @taille.Libelletaille
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="filter-empty">Aucune taille disponible</p>
                    }
                </div>

                <!-- Prix -->
                <div class="filter-section">
                    <h4 class="filter-title">Prix</h4>
                    <div class="price-range">
                        <div class="price-inputs">
                            <span>@VM_Search.SelectedMinPrice€</span>
                            <span>@VM_Search.SliderMax€</span>
                        </div>
                        <input type="range" 
                               min="@VM_Search.SelectedMinPrice" 
                               max="@VM_Search.SliderMax" 
                               @bind="VM_Search.SelectedMaxPrice"
                               @bind:after="VM_Search.OnPriceChanged"
                               class="price-slider" />
                        <div class="price-current">
                            <span>Maximum Choisi: @VM_Search.SelectedMaxPrice€</span>
                        </div>
                    </div>
                    <div class="price-range">
                        <div class="price-inputs">
                            <span>0€</span>
                            <span>@VM_Search.SelectedMaxPrice€</span>
                        </div>
                        <input type="range" 
                               min="0" 
                               max="@VM_Search.SelectedMaxPrice" 
                               @bind="VM_Search.SelectedMinPrice"
                               @bind:after="VM_Search.OnPriceChanged"
                               class="price-slider" />
                        <div class="price-current">
                            <span>Minimum Choisi: @VM_Search.SelectedMinPrice€</span>
                        </div>
                    </div>
                </div>
                <!-- État -->
                <div class="filter-section">
                    <h4 class="filter-title">État</h4>
                    <div class="filter-options">
                        @if (VM_Search.IsLoading)
                        {
                            <div class="filter-loading">
                                <div class="spinner-small"></div>
                                <span>Chargement...</span>
                            </div>
                        }else if(VM_Search.Etats != null && VM_Search.Etats.Any())
                        {
                            @foreach (var etat in VM_Search.Etats)
                            {
                                <label class="checkbox-label">
                                    <input type="checkbox"
                                           checked="@VM_Search.SelectedMarques.Contains(etat.NomEtat)"
                                           @onchange="() => VM_Search.ToggleFilter(VM_Search.SelectedEtats, etat.NomEtat)" />
                                    <span>@etat.NomEtat</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </aside>

            <!-- Products Grid -->
            <div class="products-section">
                @if (VM_Search.IsLoading)
                {
                    <div class="loading-state">
                        <div class="spinner-large"></div>
                        <p>Chargement des annonces...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(VM_Search.ErrorMessage))
                {
                    <div class="error-state">
                        <i class="bi bi-exclamation-circle"></i>
                        <p>@VM_Search.ErrorMessage</p>
                    </div>
                }
                else if (VM_Search.Annonces == null || !VM_Search.Annonces.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-search"></i>
                        <p>Aucune annonce trouvée</p>
                    </div>
                }
                else
                {
                    <div class="product-grid">
                        @foreach (var annonce in VM_Search.Annonces)
                        {
                            <AnnonceCard annonceComponent="annonce"
                                            OnToggleFavorite="VM_Profil.ToggleFavorite"
                                            OnClickAnnonce="(a) => VM_Profil.NavigateToProductDetail(a.AnnonceId)" />
                        }
                    </div>

                    @if (VM_Search.TotalPages > 1)
                    {
                        <div class="pagination-container">
                            <div class="pagination">
                                <button class="pagination-btn @(VM_Search.CurrentPage == 1 ? "disabled" : "")"
                                        @onclick="() => VM_Search.GoToPage(VM_Search.CurrentPage - 1)"
                                        disabled="@(VM_Search.CurrentPage == 1)">
                                    <i class="bi bi-chevron-left"></i>
                                    Précédent
                                </button>

                                <div class="pagination-numbers">
                                    @foreach (var pageNumber in VM_Search.GetVisiblePages())
                                    {
                                        @if (pageNumber == -1)
                                        {
                                            <span class="pagination-ellipsis">...</span>
                                        }
                                        else
                                        {
                                            <button class="pagination-number @(pageNumber == VM_Search.CurrentPage ? "active" : "")"
                                                    @onclick="() => VM_Search.GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>

                                        }
                                    }
                                </div>

                                <button class="pagination-btn @(VM_Search.CurrentPage == VM_Search.TotalPages ? "disabled" : "")"
                                        @onclick="() => VM_Search.GoToPage(VM_Search.CurrentPage + 1)"
                                        disabled="@(VM_Search.CurrentPage == VM_Search.TotalPages)">
                                    Suivant
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>

                            <div class="pagination-info">
                                Affichage de @VM_Search.GetStartItem() - @VM_Search.GetEndItem() sur @VM_Search.TotalItems résultats
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<Footer />

@code {
    protected override async Task OnInitializedAsync()
    {
        VM_Search.SetSearchViewModel(VM_Search);
        await VM_Search.InitializeFromUrlAsync();
        VM_Search.OnStateChange += StateHasChanged;
    }

    public void Dispose()
    {
        /*
        VM_ClientBase.OnStateChange -= StateHasChanged;
        Vm_NavBar.SetSearchViewModel(null);*/
    }
}