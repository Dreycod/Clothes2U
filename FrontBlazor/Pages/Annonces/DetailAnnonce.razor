@page "/product/{Id:int}"
@layout ClientLayout
@using Shared.DTO.Recense
@using Shared.DTO.Utilisateur
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(VM_DetailAnnonce.AnnonceDetail?.Title ?? "Produit") - Clothes2U</PageTitle>

<div class="product-detail-page" @onclick="HandlePageClick">
    @if (VM_DetailAnnonce.IsLoading)
    {
        <div class="loading-container">
            <div class="spinner-large"></div>
            <p>Chargement du produit...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(VM_DetailAnnonce.ErrorMessage))
    {
        <div class="error-container">
            <i class="bi bi-exclamation-circle"></i>
            <p>@VM_DetailAnnonce.ErrorMessage</p>
            <button class="btn-retry" @onclick="() => VM_DetailAnnonce.LoadAnnonceDetailAsync(Id)">Réessayer</button>
        </div>
    }
    @if (VM_DetailAnnonce.IsUserSuspended)
    {
        <div class="error-state-card">
            <i class="bi bi-ban"></i>
            <h2>Compte suspendu</h2>
            <p>L'utilisateure de cette annonce a été suspendu, vous ne pouvez pas visualiser leurs annonces.</p>
            <button class="btn-primary" @onclick="VM_DetailAnnonce.NavigateToHome">
                Retour à l'accueil
            </button>
        </div>
    }
    @if (VM_DetailAnnonce.IsBlockedByUser)
    {
        <div class="error-state-card">
            <i class="bi bi-ban"></i>
            <h2>Compte bloqué</h2>
            <p>Vous avez bloqué l'utilisateur de cette annonce, vous ne pouvez pas visualiser leurs annonces.</p>
            <button class="btn-primary" @onclick="VM_DetailAnnonce.NavigateToHome">
                Retour à l'accueil
            </button>
        </div>
    }
    else if (VM_DetailAnnonce.AnnonceDetail != null && VM_DetailAnnonce.utilisateurAnnonce != null)
    {
        AnnonceDetailDTO annonce = VM_DetailAnnonce.AnnonceDetail;
        UtilisateurViewDTO utilisateur = VM_DetailAnnonce.utilisateurAnnonce;

        <div class="product-container">
            
            <div class="product-image-section">
                <div class="main-image-wrapper">
                    <div class="main-image">
                        @if (annonce.Photos != null && annonce.Photos.Any())
                        {
                            <img src="@VM_DetailAnnonce.GetPhoto(annonce.Photos.First())" alt="@annonce.Title" />
                        }
                    </div>
                </div>
        
                @if (annonce.Photos != null && annonce.Photos.Count() > 1)
                {
                    <div class="image-thumbnails">
                        @foreach (var photo in annonce.Photos.Skip(1))
                        {
                            <button class="preview-btn" @onclick="() => VM_DetailAnnonce.ToggleImagePreview(photo)">
                                <div class="thumbnail-item">
                                    <img src="@VM_DetailAnnonce.GetPhoto(photo)" alt="Thumbnail" />
                                </div>
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="product-info-section">
                <div class="category-badge-row">
                    <div class="category-badge">@annonce.Categorie</div>
    
                    <div class="product-actions-buttons">
                        @if (VM_DetailAnnonce.Has3DModel)
                        {
                            <button class="btn-3d-viewer" 
                                    title="Voir en 3D"
                                    @onclick="VM_DetailAnnonce.Toggle3DViewer">
                                <i class="bi bi-badge-3d"></i>
                            </button>
                        }
                        @if (VM_DetailAnnonce.AnnonceDetail.IsOwnerAnnonce)
                        {
                            <div class="product-actions-dropdown-container" @onclick:stopPropagation="true">
                                <button class="btn-dropdown-toggle"
                                        title="Actions"
                                        @onclick="VM_DetailAnnonce.ToggleActionsDropdown">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                
                                @if (VM_DetailAnnonce.ShowActionsDropdown)
                                {
                                    <div class="product-dropdown">
                                        <button class="dropdown-item" @onclick="VM_DetailAnnonce.ModifierAnnonce">
                                            <i class="bi bi-pencil"></i>
                                            <span>Modifier</span>
                                        </button>
                                        <button class="dropdown-item" @onclick="VM_DetailAnnonce.TogglePauseResumeModal">
                                            <i class="bi bi-@(annonce.StatutAnnonceId == 5 ? "play-circle" : "pause-circle")"></i>
                                            <span>@(annonce.StatutAnnonceId == 5 ? "Reprendre l'annonce" : "Mettre en pause")</span>
                                        </button>
                                        <button class="dropdown-item" @onclick="VM_DetailAnnonce.ToggleDeleteProductModal">
                                            <i class="bi bi-trash"></i>
                                            <span>Supprimer l'article</span>
                                        </button>
                                    </div>
                                }
                                </div>
                        }
                    </div>
                </div>
                
                <h1 class="product-title">@annonce.Title</h1>

                <div class="brand-price-row">
                    <span class="brand-name">@annonce.NomMarque</span>
                    <span class="product-price">@annonce.Prix€</span>
                </div>

                <div class="price-status">
                    @if (annonce.Negociable)
                    {
                        <span class="badge badge-negotiable">Prix négociable</span>
                    }
                    else
                    {
                        <span class="badge badge-non-negotiable">Prix non négociable</span>
                    }
                </div>

                <div class="actions-row">
                    @if (!VM_DetailAnnonce.AnnonceDetail.IsOwnerAnnonce)
                    {
                        <button class="btn-action"
                                @onclick:stopPropagation="true"
                                @onclick="() => VM_DetailAnnonce.ToggleFavorite(annonce)">
                            <i class="bi bi-heart@(annonce.IsLikedByCurrentUser ? "-fill" : "")"></i>
                        </button>
                        <button class="btn-action" @onclick="VM_DetailAnnonce.ToggleSignalerModal">
                            <i class="bi bi-flag"></i>
                        </button>
                    }
                </div>

                <div class="seller-section" @onclick="VM_DetailAnnonce.GotoProfile">
                    <img class="seller-avatar" src="@(VM_DetailAnnonce.GetPhoto(utilisateur.PhotoProfilId))" />
                    <div class="seller-info">
                        <h3 class="seller-name">@(utilisateur.Login ?? "Vendeur")</h3>
                        <div class="seller-rating">
                            <i class="bi bi-star-fill"></i>
                            <span>@(utilisateur.MoyenneAvis) (@(utilisateur.NombreAvis) avis)</span>
                        </div>
                    </div>
                </div>

                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Taille</div>
                        <div class="detail-value">@(annonce.Taille)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">État</div>
                        <div class="detail-value">@(annonce.EtatArticle)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Sous Catégorie</div>
                        <div class="detail-value">@(annonce.SousCategorie)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Couleur@(annonce.Couleurs?.Count > 1 ? "s" : "")</div>
                        <div class="couleurs-container">
                            @if (annonce.Couleurs != null && annonce.Couleurs.Any())
                            {
                                @foreach (var couleur in annonce.Couleurs)
                                {
                                    <CouleurBadge Couleur="@couleur" />
                                }
                            }
                            else
                            {
                                <span class="detail-value">Non spécifié</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="description-section">
                    <h3 class="section-title">Description</h3>
                    <p class="description-text">
                        @(annonce.Description ?? "Aucune description disponible.")
                    </p>
                </div>

                <div class="tags-section">
                    <h3 class="section-title">Tags</h3>
                    <div class="tags-container">
                        @if (VM_DetailAnnonce.AnnonceDetail.Tags != null && VM_DetailAnnonce.AnnonceDetail.Tags.Any())
                        {
                            @foreach (string tag in VM_DetailAnnonce.AnnonceDetail.Tags)
                            {
                                <AnnonceTag Tag="@tag" />
                            }
                        }
                        else
                        {
                            <p>Aucun tag associé.</p>
                        }
                    </div>
                </div>

                <div class="product-stats">
                    <span><i class="bi bi-calendar"></i> Publié le @(annonce.DateAnnonce.ToString("dd/MM/yyyy"))</span>
                    <span><i class="bi bi@(annonce.IsLikedByCurrentUser ? "-heart-fill" : "-heart")"></i> @(annonce.NombreLikes) likes</span>
                    <span><i class="bi bi-eye"></i> @(annonce.NombreVues) vues </span>
                </div>

                @if (!VM_DetailAnnonce.AnnonceDetail.IsOwnerAnnonce)
                {
                    <div class="action-buttons">
                        <button class="btn-secondary" @onclick="VM_DetailAnnonce.ContactSeller">
                            Contacter le vendeur
                        </button>
                        @if (annonce.Negociable)
                        {
                            <button class="btn-secondary" @onclick="VM_DetailAnnonce.MakeOffer">
                                Faire une offre
                            </button>
                        }
                    </div>

                    <button class="btn-primary" @onclick="VM_DetailAnnonce.BuyProduct">
                        Acheter l'article
                    </button>
                }
            </div>
        </div>

        <div class="similar-section">
            <div class="similar-container">
                <div class="similar-header">
                    <h2 class="similar-title">Annonces similaires</h2>
                    <div class="carousel-controls">
                        <button class="carousel-btn" @onclick="VM_DetailAnnonce.PreviousSimilar">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="carousel-btn" @onclick="VM_DetailAnnonce.NextSimilar">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
                
                <div class="similar-grid">
                    @if (VM_DetailAnnonce.IsLoadingSimilar)
                    {
                        <div class="loading-container">
                            <div class="spinner-large"></div>
                            <p>Chargement des annonces similaires...</p>
                        </div>
                    }
                    else if(VM_DetailAnnonce.similarAnnonces != null && VM_DetailAnnonce.similarAnnonces.Any())
                    {
                        @foreach (AnnonceDTO similairAnnonce in VM_DetailAnnonce.similarAnnonces)
                        {
                            <AnnonceCard annonceComponent="similairAnnonce"
                                         OnToggleFavorite="(a) => VM_DetailAnnonce.ToggleFavorite(a)"    
                                         OnClickAnnonce="(a) => VM_DetailAnnonce.NavigateToProduct(a.AnnonceId)"/>
                        }
                    }
                    else
                    {
                        <p>Aucun produit similaire disponible</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (VM_DetailAnnonce.ShowSignalerModal)
{
    <div class="modal-overlay" @onclick="VM_DetailAnnonce.ToggleSignalerModal">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Signalement d'annonce</h3>
                <button class="modal-close" @onclick="VM_DetailAnnonce.ToggleSignalerModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Raison</label>
                    <textarea class="form-textarea"
                              placeholder="Restez civil, une vraie personne lira votre signalement..."
                              @bind="VM_DetailAnnonce.SignalementRaison"
                              @bind:event="oninput"
                              rows="6"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_DetailAnnonce.ToggleSignalerModal">Annuler</button>
                <button class="btn-primary" @onclick="VM_DetailAnnonce.SubmitReport" disabled="@VM_DetailAnnonce.IsSubmittingReport">
                    @if (VM_DetailAnnonce.IsSubmittingReport)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Signalement d'annonce</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (VM_DetailAnnonce.ShowDeleteProductModal)
{
    <div class="modal-overlay" @onclick="() => VM_DetailAnnonce.ToggleDeleteProductModal()">
        <div class="modal-content review-modal delete-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Suppression de votre annonce</h3>
                <button class="modal-close" @onclick="() => VM_DetailAnnonce.ToggleDeleteProductModal()">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>Êtes-vous sûr de vouloir supprimer cette annonce ? Cette action est irréversible.</span>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="() => VM_DetailAnnonce.ToggleDeleteProductModal()">Annuler</button>
                <button class="btn-danger"
                        @onclick="async () => await VM_DetailAnnonce.DeleteProduct()"
                        disabled="@VM_DetailAnnonce.IsSubmittingDelete">
                    @if (VM_DetailAnnonce.IsSubmittingDelete)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Suppression...</span>
                    }
                    else
                    {
                        <span>Supprimer l'annonce</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (VM_DetailAnnonce.ShowPauseResumeModal)
{
    <div class="modal-overlay" @onclick="() => VM_DetailAnnonce.TogglePauseResumeModal()">
        <div class="modal-content review-modal delete-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>
                    @if (VM_DetailAnnonce.AnnonceDetail.StatutAnnonceId == 5)
                    {
                        <span>Reprendre l'annonce</span>
                    }
                    else
                    {
                        <span>Mettre l'annonce en pause</span>
                    }
                </h3>
                <button class="modal-close" @onclick="() => VM_DetailAnnonce.TogglePauseResumeModal()">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-@(VM_DetailAnnonce.AnnonceDetail.StatutAnnonceId == 5 ? "play-circle" : "pause-circle")"></i>
                    @if (VM_DetailAnnonce.AnnonceDetail.StatutAnnonceId == 5)
                    {
                        <span>Êtes-vous sûr de vouloir reprendre cette annonce ? Elle sera visible par tous les utilisateurs.</span>
                    }
                    else
                    {
                        <span>Êtes-vous sûr de vouloir mettre cette annonce en pause ? Elle ne sera plus visible par les autres utilisateurs.</span>
                    }
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="() => VM_DetailAnnonce.TogglePauseResumeModal()">
                    Annuler
                </button>
                <button class="@(VM_DetailAnnonce.AnnonceDetail.StatutAnnonceId == 5 ? "btn-primary" : "btn-pause")"
                        @onclick="async () => await VM_DetailAnnonce.PauserReprendreAnnonce()"
                        disabled="@VM_DetailAnnonce.IsSubmittingPauseResume">
                    @if (VM_DetailAnnonce.IsSubmittingPauseResume)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>En cours...</span>
                    }
                    else
                    {
                        @if (VM_DetailAnnonce.AnnonceDetail.StatutAnnonceId == 5)
                        {
                            <span>Reprendre l'annonce</span>
                        }
                        else
                        {
                            <span>Mettre en pause</span>
                        }
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (VM_DetailAnnonce.ShowImagePreview)
{
    <div class="image-preview-overlay" @onclick="() => VM_DetailAnnonce.ToggleImagePreview(0)">
        <div class="image-preview-container" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => VM_DetailAnnonce.ToggleImagePreview(0)">
                <i class="bi bi-x"></i>
            </button>
            <div class="image-preview-content">
                <img src="@VM_DetailAnnonce.ImagePreview" alt="Image Preview" />
            </div>
        </div>
    </div>
}

@if (VM_DetailAnnonce.Show3DViewer)
{
    <div class="modal-overlay" @onclick="VM_DetailAnnonce.Toggle3DViewer">
        <div class="modal-content viewer-3d-modal" 
             style="width: 90vw; max-width: 1200px; height: 85vh; display: flex; flex-direction: column;"
             @onclick:stopPropagation>
            <div class="modal-header" style="flex-shrink: 0;">
                <h3>Visualisation 3D</h3>
                <button class="modal-close" @onclick="VM_DetailAnnonce.Toggle3DViewer">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="viewer-3d-container" 
                 style="flex: 1; background: #f0f0f0; position: relative; min-height: 500px;">
                <div id="3d-canvas-detail" 
                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _3dViewerInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        await VM_DetailAnnonce.LoadAnnonceDetailAsync(Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (VM_DetailAnnonce.Show3DViewer && !_3dViewerInitialized && VM_DetailAnnonce.AnnonceDetail != null)
        {
            try
            {
                _3dViewerInitialized = true;
            
                bool isReady = await JS.InvokeAsync<bool>("waitForElement", "3d-canvas-detail");
            
                if (!isReady)
                {
                    Console.WriteLine("Container failed to initialize");
                    _3dViewerInitialized = false;
                    return;
                }
            
                var modelUrl = $"/assets/{VM_DetailAnnonce.AnnonceDetail.SousCategorie}.gltf";
                var firstPhotoId = VM_DetailAnnonce.AnnonceDetail.Photos.FirstOrDefault();
                var textureUrl = VM_DetailAnnonce.GetPhoto(firstPhotoId);
            
                await JS.InvokeVoidAsync("initAndApplyTexture", "3d-canvas-detail", modelUrl, textureUrl);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
                _3dViewerInitialized = false;
            }
        }
        else if (!VM_DetailAnnonce.Show3DViewer && _3dViewerInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("clearCanvas", "3d-canvas-detail");
            }
            catch { }
            finally
            {
                _3dViewerInitialized = false;
            }
        }
    }

    private async Task<bool> WaitForContainerReady(string containerId, int maxAttempts = 20)
    {
        for (int i = 0; i < maxAttempts; i++)
        {
            try
            {
                var dimensions = await JS.InvokeAsync<int[]>("eval", 
                    $@"(() => {{
                        const el = document.getElementById('{containerId}');
                        if (!el) return [0, 0];
                        return [el.clientWidth, el.clientHeight];
                    }})()");
            
                if (dimensions[0] > 0 && dimensions[1] > 0)
                {
                    Console.WriteLine($"Container ready after {i * 50}ms: {dimensions[0]}x{dimensions[1]}");
                    return true;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Attempt {i + 1} failed: {ex.Message}");
            }
        
            await Task.Delay(50);
        }
    
        Console.WriteLine($"Container not ready after {maxAttempts * 50}ms");
        return false;
    }

    private void HandlePageClick()
    {
        if (VM_DetailAnnonce.ShowActionsDropdown)
        {
            VM_DetailAnnonce.ShowActionsDropdown = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        VM_DetailAnnonce.CancelVisualisation();
    }
}