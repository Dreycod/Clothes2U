@page "/settings"
@layout ClientLayout
@inject SettingsViewModel VM_Settings
@inject NavigationManager NavigationManager

<PageTitle>Paramètres - Clothes2U</PageTitle>

<NavBar />

<div class="settings-page">
    <div class="settings-container">
        @if (VM_Settings.IsLoading)
        {
            <div class="page-loading-state">
                <div class="spinner-large"></div>
                <p>Chargement des paramètres...</p>
            </div>
        }
        else if(VM_Settings.IsLoggedIn)
        {
            <div class="settings-header">
                <h1>Paramètres</h1>
                <p>Gérez vos informations personnelles et vos préférences</p>
            </div>

            <div class="settings-tabs">
                <button class="tab-btn @(VM_Settings.ActiveTab == "account" ? "active" : "")"
                        @onclick='async () => await VM_Settings.SetActiveTab("account")'>

                    <i class="bi bi-person"></i>
                    <span>Compte</span>
                </button>
                <button class="tab-btn @(VM_Settings.ActiveTab == "security" ? "active" : "")"
                        @onclick='async () => await VM_Settings.SetActiveTab("security")'>
                    <i class="bi bi-shield-lock"></i>
                    <span>Sécurité</span>
                </button>
                <button class="tab-btn @(VM_Settings.ActiveTab == "blocked" ? "active" : "")"
                        @onclick='async () => await VM_Settings.SetActiveTab("blocked")'>
                    <i class="bi bi-person-x"></i>
                    <span>Utilisateurs bloqués</span>
                </button>
            </div>

            <div class="tab-content">
                @if (VM_Settings.ActiveTab == "account")
                {
                    <div class="settings-section">
                        <h2 class="section-title">Informations du compte</h2>

                        <div class="settings-card">
                            <div class="card-header">
                                <h3>Photo de profil</h3>
                            </div>
                            <div class="card-body">
                                <div class="photo-upload-container">
                                    <img class="profile-photo-preview" 
                                         src="@(VM_Settings.PreviewPhotoUrl ?? VM_Settings.GetPhotoUrl(VM_Settings.CurrentUser.PhotoProfilId))"
                                         alt="Photo de profil" />
                                    <div class="photo-upload-actions">
                                        @if (VM_Settings.UploadedPhotoBytes == null)
                                        {
                                            <label for="photoUpload" class="btn-primary" style="cursor: pointer;">
                                                <i class="bi bi-camera"></i>
                                                Changer la photo
                                            </label>
                                            <InputFile id="photoUpload" 
                                                       accept="image/*" 
                                                       OnChange="VM_Settings.HandlePhotoUpload"
                                                       style="display: none;" />
                                        }
                                        else
                                        {
                                            <div class="photo-action-buttons">
                                                <button class="btn-primary" @onclick="VM_Settings.ConfirmPhotoUpload" disabled="@VM_Settings.IsUploadingPhoto">
                                                    @if (VM_Settings.IsUploadingPhoto)
                                                    {
                                                        <span class="spinner-small-inline"></span>
                                                        <span>Envoi...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                        <span>Confirmer</span>
                                                    }
                                                </button>
                                                <button class="btn-secondary" @onclick="VM_Settings.CancelPhotoUpload" disabled="@VM_Settings.IsUploadingPhoto">
                                                    <i class="bi bi-x-lg"></i>
                                                    Annuler
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="settings-card">
                            <div class="card-header">
                                <h3>Nom d'utilisateur</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <input type="text"
                                           class="form-input" 
                                           placeholder="Nom d'utilisateur"
                                           @bind="VM_Settings.Username"
                                           @bind:event="oninput" />
                                </div>
                                @if (!string.IsNullOrEmpty(VM_Settings.UsernameError))
                                {
                                    <div class="alert alert-error">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>@VM_Settings.UsernameError</span>
                                    </div>
                                }
                                @if (VM_Settings.UsernameUpdateSuccess)
                                {
                                    <div class="alert alert-success">
                                        <i class="bi bi-check-circle"></i>
                                        <span>Pseudo mis à jour avec succès</span>
                                    </div>
                                }
                                <button class="btn-primary" 
                                        @onclick="VM_Settings.UpdateUsername"
                                        disabled="@VM_Settings.IsUpdatingUsername">
                                    @if (VM_Settings.IsUpdatingUsername)
                                    {
                                        <span class="spinner-small-inline"></span>
                                        <span>Mise à jour...</span>
                                    }
                                    else
                                    {
                                        <span>Enregistrer</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="settings-card">
                            <div class="card-header">
                                <h3>Adresse email</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <input type="email" 
                                           class="form-input" 
                                           placeholder="Email"
                                           @bind="VM_Settings.Email"
                                           @bind:event="oninput" />
                                </div>
                                @if (!string.IsNullOrEmpty(VM_Settings.EmailError))
                                {
                                    <div class="alert alert-error">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>@VM_Settings.EmailError</span>
                                    </div>
                                }
                                @if (VM_Settings.EmailUpdateSuccess)
                                {
                                    <div class="alert alert-success">
                                        <i class="bi bi-check-circle"></i>
                                        <span>Email mis à jour avec succès</span>
                                    </div>
                                }
                                <button class="btn-primary" 
                                        @onclick="VM_Settings.UpdateEmail"
                                        disabled="@VM_Settings.IsUpdatingEmail">
                                    @if (VM_Settings.IsUpdatingEmail)
                                    {
                                        <span class="spinner-small-inline"></span>
                                        <span>Mise à jour...</span>
                                    }
                                    else
                                    {
                                        <span>Enregistrer</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="settings-card">
                            <div class="card-header">
                                <h3>Préférences de notification</h3>
                            </div>
                            <div class="card-body">
                                <p class="preference-description">Choisissez comment vous souhaitez recevoir les notifications</p>
                                <button class="verif-btn"
                                        @onclick='() => NavigationManager.NavigateTo("/verification")'>
                                    <i class="bi bi-shield-check"></i>
                                    <span>Cliquez ici pour vérifier votre compte</span>
                                </button>
                                @if (!VM_Settings.CurrentUser.ValidEmail == true)
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>Vous devez vérifier votre adresse email pour activer les notifications.</span>
                                    </div>
                                }

                                <div class="checkbox-group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" 
                                               class="checkbox-input"
                                               checked="@VM_Settings.EmailNotificationsEnabled"
                                               @onchange="VM_Settings.ToggleEmailNotifications"
                                               disabled="@(!VM_Settings.CurrentUser?.ValidEmail == true || VM_Settings.IsUpdatingNotifications)" />
                                        <span class="checkbox-custom"></span>
                                        <div class="checkbox-text">
                                            <span class="checkbox-title">Notifications par email</span>
                                            <span class="checkbox-subtitle">Recevez des emails pour les messages et activités importantes</span>
                                        </div>
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(VM_Settings.NotificationError))
                                {
                                    <div class="alert alert-error">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>@VM_Settings.NotificationError</span>
                                    </div>
                                }

                                @if (VM_Settings.NotificationUpdateSuccess)
                                {
                                    <div class="alert alert-success">
                                        <i class="bi bi-check-circle"></i>
                                        <span>Préférences mises à jour avec succès</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (VM_Settings.ActiveTab == "security")
                {
                    <div class="settings-section">
                        <h2 class="section-title">Sécurité du compte</h2>

                        <div class="settings-card">
                            <div class="card-header">
                                <h3>Modifier le mot de passe</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label class="form-label">Mot de passe actuel</label>
                                    <div class="input-wrapper">
                                        <input type="@(ShowCurrentPassword ? "text" : "password")" 
                                               class="form-control" 
                                               placeholder="Entrez votre mot de passe actuel"
                                               @bind="CurrentPassword" 
                                               @bind:event="oninput" 
                                               @onkeydown="@HandleKeyDown" />
                                        <button type="button" class="password-toggle" @onclick="ToggleCurrentPassword">
                                            <i class="bi bi-eye@(ShowCurrentPassword ? "-slash" : "")"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Nouveau mot de passe</label>
                                    <div class="input-wrapper">
                                        <input type="@(ShowNewPassword ? "text" : "password")" 
                                               class="form-control" 
                                               placeholder="Entrez votre nouveau mot de passe"
                                               @bind="NewPassword" 
                                               @bind:event="oninput" 
                                               @onkeydown="@HandleKeyDown" />
                                        <button type="button" class="password-toggle" @onclick="ToggleNewPassword">
                                            <i class="bi bi-eye@(ShowNewPassword ? "-slash" : "")"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Confirmer le nouveau mot de passe</label>
                                    <div class="input-wrapper">
                                        <input type="@(ShowNewConfirmPassword ? "text" : "password")" 
                                               class="form-control" 
                                               placeholder="Confirmez votre nouveau mot de passe"
                                               @bind="NewConfirmPassword" 
                                               @bind:event="oninput" 
                                               @onkeydown="@HandleKeyDown" />
                                        <button type="button" class="password-toggle" @onclick="ToggleNewConfirmPassword">
                                            <i class="bi bi-eye@(ShowNewConfirmPassword ? "-slash" : "")"></i>
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(PasswordError))
                                {
                                    <div class="alert alert-error">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>@PasswordError</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(PasswordSuccess))
                                {
                                    <div class="alert alert-success">
                                        <i class="bi bi-check-circle"></i>
                                        <span>@PasswordSuccess</span>
                                    </div>
                                }

                                <button class="btn-primary" 
                                        @onclick="HandlePasswordUpdate"
                                        disabled="@IsUpdatingPassword">
                                    @if (IsUpdatingPassword)
                                    {
                                        <span class="spinner-small-inline"></span>
                                        <span>Mise à jour...</span>
                                    }
                                    else
                                    {
                                        <span>Modifier le mot de passe</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="settings-card">
                            <div class="card-header">
                                <h3>Suppression de compte</h3>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <span>Cette action est irréversible. Toutes vos données seront définitivement supprimées.</span>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Mot de passe</label>
                                    <div class="input-wrapper">
                                        <input type="@(ShowDeletePassword ? "text" : "password")" 
                                               class="form-control" 
                                               placeholder="Entrez votre mot de passe pour confirmer"
                                               @bind="DeleteAccountPassword" 
                                               @bind:event="oninput" 
                                               @onkeydown="@HandleKeyDown" />
                                        <button type="button" class="password-toggle" @onclick="ToggleDeletePassword">
                                            <i class="bi bi-eye@(ShowDeletePassword ? "-slash" : "")"></i>
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(DeletionError))
                                {
                                    <div class="alert alert-error">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>@DeletionError</span>
                                    </div>
                                }

                                <div class="delete-account-actions">
                                    @if (IsDeletingAccount)
                                    {
                                        <button class="btn-danger" disabled>
                                            <span class="spinner-small-inline"></span>
                                            Suppression du compte...
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-danger" @onclick="HandleAccountDeletion">
                                            <i class="bi bi-trash"></i>
                                            Supprimer le compte
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (VM_Settings.ActiveTab == "blocked")
                {
                    <div class="settings-section">
                        <h2 class="section-title">Utilisateurs bloqués</h2>

                        <div class="settings-card">
                            @if (VM_Settings.IsLoadingBlocked)
                            {
                                <div class="tab-loading-state">
                                    <div class="spinner-medium"></div>
                                    <p>Chargement des utilisateurs bloqués...</p>
                                </div>
                            }
                            else if (VM_Settings.UtilisateursBloques != null && VM_Settings.UtilisateursBloques.Any())
                            {
                                <div class="blocked-users-list">
                                    @foreach (BloqueDetailDTO user in VM_Settings.UtilisateursBloques)
                                    {
                                        <div class="blocked-user-item">
                                            <div class="blocked-user-info">
                                                <img class="blocked-user-avatar" 
                                                     src="@VM_Settings.GetPhotoUrl(user.BloqueurId)" 
                                                     alt="@user." />
                                                <div class="blocked-user-details">
                                                    <h4>@user.UtilisateurBloqueLogin</h4>
                                                </div>
                                            </div>
                                            <button class="btn-unblock" 
                                                    @onclick="() => VM_Settings.UnblockUser(user.UtilisateurBloqueId)"
                                                    disabled="@VM_Settings.IsUnblocking"
                                                    title="Débloquer">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="bi bi-person-check"></i>
                                    <p>Vous n'avez bloqué aucun utilisateur</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<Footer />

@code {
    public bool ShowCurrentPassword { get; set; } = false;
    public bool ShowNewPassword { get; set; } = false;
    public bool ShowNewConfirmPassword { get; set; } = false;

    public string CurrentPassword { get; set; } = string.Empty;
    public string NewPassword { get; set; } = string.Empty;
    public string NewConfirmPassword { get; set; } = string.Empty;

    public bool ShowDeletePassword { get; set; } = false;
    public string DeleteAccountPassword { get; set; } = string.Empty;
    public bool IsDeletingAccount { get; set; } = false;

    public string PasswordError { get; set; } = string.Empty;
    public string PasswordSuccess { get; set; } = string.Empty;
    public string DeletionError { get; set; } = string.Empty;
    public bool IsUpdatingPassword { get; set; } = false;

    public void ToggleCurrentPassword() => ShowCurrentPassword = !ShowCurrentPassword;
    public void ToggleNewPassword() => ShowNewPassword = !ShowNewPassword;
    public void ToggleNewConfirmPassword() => ShowNewConfirmPassword = !ShowNewConfirmPassword;
    public void ToggleDeletePassword() => ShowDeletePassword = !ShowDeletePassword;

    protected override async Task OnInitializedAsync()
    {
        await VM_Settings.LoadSettings();
    }

    private async Task HandlePasswordUpdate()
    {
        PasswordError = PasswordSuccess = string.Empty;
        IsUpdatingPassword = true;

        try
        {
            var result = await VM_Settings.UpdatePassword(CurrentPassword, NewPassword, NewConfirmPassword);
            if (result == "Success")
            {
                PasswordSuccess = "Mot de passe mis à jour avec succès";
                CurrentPassword = NewPassword = NewConfirmPassword = string.Empty;
            }
            else
            {
                PasswordError = result ?? "Erreur lors de la mise à jour du mot de passe.";
            }
        }
        catch (Exception ex)
        {
            PasswordError = $"Erreur: {ex.Message}";
        }
        finally
        {
            IsUpdatingPassword = false;
            StateHasChanged();
        }
    }

    private async Task HandleAccountDeletion()
    {
        DeletionError = string.Empty;
        IsDeletingAccount = true;

        try
        {
            var result = await VM_Settings.AccountDeletion(DeleteAccountPassword);
            if (result == "Success")
            {
                // Redirect to home or login page after successful deletion
                NavigationManager.NavigateTo("/", true);
            }
            else
            {
                DeletionError = result ?? "Erreur lors de la suppression du compte.";
            }
        }
        catch (Exception ex)
        {
            DeletionError = $"Erreur: {ex.Message}";
        }
        finally
        {
            IsDeletingAccount = false;
            StateHasChanged();
        }
    }

    public async Task HandleKeyDown(KeyboardEventArgs e) {}

    public void Dispose()
    {
        VM_Settings.OnStateChanged -= StateHasChanged;
    }
}