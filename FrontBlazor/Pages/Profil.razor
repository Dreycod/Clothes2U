@page "/profile/{userLogin}"
@inject NavigationManager NavigationManager
@layout ClientLayout

<PageTitle>Clothes2U</PageTitle>

<!-- Navigation Bar -->
<NavBar />

<div class="profile-page">
    <div class="profile-container">
        @if (VM_Profil.IsLoading)
        {
            <!-- Page Loading State -->
            <div class="page-loading-state">
                <div class="spinner-large"></div>
                <p>Chargement du profil...</p>
            </div>
        }

        else if (VM_Profil.UserNotFound)
        {
            <!-- User Not Found State -->
            <div class="error-state-card">
                <i class="bi bi-person-x"></i>
                <h2>Utilisateur introuvable</h2>
                <p>L'utilisateur que vous recherchez n'existe pas ou a été supprimé.</p>
                <button class="btn-primary" @onclick="VM_Profil.NavigateToHome">
                    Retour à l'accueil
                </button>
            </div>
        }
        else if (VM_Profil.UserSuspended)
        {
            <!-- User Suspended State -->
            <div class="error-state-card">
                <i class="bi bi-ban"></i>
                <h2>Compte suspendu</h2>
                <p>Ce compte a été temporairement suspendu.</p>
                <button class="btn-primary" @onclick="VM_Profil.NavigateToHome">
                    Retour à l'accueil
                </button>
            </div>
        }
        else if (VM_Profil.ViewingUser != null)
        {
            @if (VM_Profil.IsBlockedByUser)
            {
                <div class="error-state-card">
                    <i class="bi bi-person-x"></i>
                    <h2>Utilisateur bloqué</h2>
                    <p>Vous avez bloqué cet utilisateur, vous pouvez le débloquer si vous le souhaitez.</p>
                    <div class="error-state-actions">
                        <button class="btn-secondary" @onclick="VM_Profil.NavigateToHome">
                            Retour à l'accueil
                        </button>
                        <button class="btn-primary" @onclick="VM_Profil.ToggleBloque">
                            Débloquer l'utilisateur
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Profile Header -->
                <div class="profile-header">
                    <img class="profile-avatar" src="@(VM_Profil.GetPhoto(VM_Profil.ViewingUser.PhotoProfilId))" />
                    <div class="profile-info">
                        <div class="profile-top-row">
                            <h1 class="profile-name">@VM_Profil.ViewingUser.Login  @if (VM_Profil.ViewingUser.ValidEmail || VM_Profil.ViewingUser.ValidTelephone) {<i class="bi bi-patch-check"></i>} </h1>
                        <div class="profile-actions">
                            @if (VM_Profil.IsSameUser)
                            {
                                <!-- 🆕 Bouton "Ajouter un article" visible uniquement pour l'utilisateur connecté -->
                                <button class="btn-add-article-header" @onclick="VM_Profil.NavigateToAddArticle">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Ajouter un article</span>
                                </button>

                                <!-- Menu trois points (optionnel pour le propriétaire) -->
                                <div class="profile-dropdown-container">
                                    <button class="btn-icon"
                                            title="Paramètres"
                                            @onclick="VM_Profil.ToggleDotsDropdown">
                                        <i class="bi bi-three-dots"></i>
                                    </button>

                                    @if (VM_Profil.showDotsDropdown)
                                    {
                                        <div class="profile-dropdown">
                                            <button class="dropdown-item" @onclick='() => NavigationManager.NavigateTo("/verification")'>
                                                <i class="bi bi-shield-check"></i>
                                                <span>Vérification</span>
                                            </button>
                                            <!-- Ajoutez d'autres options ici si nécessaire -->
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Options pour les visiteurs -->
                                <div class="profile-dropdown-container">
                                    <button class="btn-icon"
                                            title="Actions"
                                            @onclick="VM_Profil.ToggleDotsDropdown">
                                        <i class="bi bi-three-dots"></i>
                                    </button>

                                    @if (VM_Profil.showDotsDropdown)
                                    {
                                        <div class="profile-dropdown">
                                            <button class="dropdown-item danger" @onclick="VM_Profil.ToggleBloqueModal">
                                                <i class="bi bi-person-x"></i>
                                                <span>Bloquer</span>
                                            </button>

                                            <button class="dropdown-item danger" @onclick="VM_Profil.ToggleSignalerModal">
                                                <i class="bi bi-flag"></i>
                                                <span>Signaler</span>
                                            </button>
                                        </div>
                                    }
                                </div>

                                <button class="btn-follow" @onclick="VM_Profil.ToggleAbonnement">
                                    @(VM_Profil.ViewingUser.FolloweddByCurrentUser ? "Se désabonner" : "S'abonner")
                                </button>
                            }
                        </div>
                        </div>
                        @* <div class="profile-location">
                        <i class="bi bi-geo-alt"></i>
                        <span>Annecy, France</span>
                    </div> *@
                        <div class="profile-stats-row">
                            @if (VM_Profil.IsSameUser)
                            {
                                <span class="profile-stat clickable" @onclick="VM_Profil.OpenAbonnementsModal">
                                    @VM_Profil.ViewingUser.Abonnements Abonnements
                                </span>
                                <span>, </span>
                                <span class="profile-stat clickable">
                                    @VM_Profil.ViewingUser.Abonnes Abonnés
                                </span>
                            }
                            else
                            {
                                <span class="profile-stat">
                                    @VM_Profil.ViewingUser.Abonnements Abonnements, @VM_Profil.ViewingUser.Abonnes Abonnés
                                </span>
                            }
                        </div>
                        <div class="profile-member-info">
                            <span>Membre depuis @(VM_Profil.ViewingUser.DateInscription.ToString("MMMM yyyy"))</span>
                            <div class="profile-rating">
                                <i class="bi bi-star-fill"></i>
                                <span>@(VM_Profil.ViewingUser.MoyenneAvis) (@(VM_Profil.AvisCount) avis)</span>
                            </div>
                        </div>
                        @if (VM_Profil.IsSameUser)
                        {
                            <div class="profile-preferences">

                                <button class="btn-toggle"
                                        @onclick="VM_Profil.ToggleNotifMailPreference"
                                        disabled="@(!VM_Profil.ViewingUser.ValidEmail || VM_Profil.IsUpdatingNotifMail)">

                                    @if (VM_Profil.IsUpdatingNotifMail)
                                    {
                                        <span class="spinner-small-inline"></span>
                                        <span> Mise à jour...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-envelope"></i>
                                        <span>
                                            Notifications email :
                                            <strong>
                                                @(VM_Profil.ViewingUser.PreferenceNotifMail ? "ON" : "OFF")
                                            </strong>
                                        </span>
                                    }
                                </button>

                                @if (!VM_Profil.ViewingUser.ValidEmail)
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-circle"></i>
                                        <span>
                                            Vous devez vérifier votre adresse email pour activer les notifications.
                                        </span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(VM_Profil.NotifMailErrorMessage))
                                {
                                    <div class="alert alert-error">
                                        <i class="bi bi-x-circle"></i>
                                        <span>@VM_Profil.NotifMailErrorMessage</span>
                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>

                <!-- Tabs Navigation -->
                <div class="profile-tabs">
                    <button class="tab-btn @(VM_Profil.ActiveTab == "articles" ? "active" : "")"
                            @onclick='() => VM_Profil.SetActiveTab("articles")'>
                        <i class="bi bi-bag"></i>
                        <span>Articles</span>
                    </button>
                    @if (VM_Profil.IsSameUser)
                    {
                        <button class="tab-btn @(VM_Profil.ActiveTab == "favoris" ? "active" : "")"
                                @onclick='() => VM_Profil.SetActiveTab("favoris")'>
                            <i class="bi bi-heart"></i>
                            <span>Favoris</span>
                        </button>
                    }
                    <button class="tab-btn @(VM_Profil.ActiveTab == "avis" ? "active" : "")"
                            @onclick='() => VM_Profil.SetActiveTab("avis")'>
                        <i class="bi bi-star"></i>
                        <span>Avis</span>
                    </button>

                </div>

                <!-- Tab Content -->
                <div class="tab-content">
                    @if (VM_Profil.ActiveTab == "articles")
                    {
                        @if (VM_Profil.IsLoadingArticles)
                        {
                            <div class="tab-loading-state">
                                <div class="spinner-medium"></div>
                                <p>Chargement des articles...</p>
                            </div>
                        }
                        else if (VM_Profil.Annonces != null && VM_Profil.Annonces.Any())
                        {
                            <div class="products-grid">
                                @foreach (var annonce in VM_Profil.Annonces)
                                {
                                    <AnnonceCard annonceComponent="annonce"
                                                 OnToggleFavorite="VM_Profil.ToggleFavorite"
                                                 OnClickAnnonce="(a) => VM_Profil.NavigateToProductDetail(a.AnnonceId)"
                                                 IsOwnerTask="VM_Profil.CheckIfOwnerAnnonce(annonce)" />

                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                @if (VM_Profil.IsSameUser)
                                {
                                    <p>Vous n'avez pas encore mis en vente des articles</p>
                                    <button class="btn-add-article" @onclick="VM_Profil.NavigateToAddArticle">
                                        Ajouter un article
                                    </button>
                                }
                                else
                                {
                                    <p>L'utilisateur n'a pas posté d'annonces</p>
                                }
                            </div>
                        }
                    }
                    else if (VM_Profil.ActiveTab == "favoris")
                    {
                        @if (VM_Profil.IsLoadingFavoris)
                        {
                            <div class="tab-loading-state">
                                <div class="spinner-medium"></div>
                                <p>Chargement des favoris...</p>
                            </div>
                        }
                        else if (VM_Profil.FavorisAnnonce != null && VM_Profil.FavorisAnnonce.Any())
                        {
                            <div class="products-grid">
                                @foreach (AnnonceDTO annonce in VM_Profil.FavorisAnnonce)
                                {
                                    <AnnonceCard annonceComponent="annonce"
                                                 OnToggleFavorite="VM_Profil.ToggleFavorite"
                                                 OnClickAnnonce="(a) => VM_Profil.NavigateToProductDetail(a.AnnonceId)"
                                                 IsOwnerTask="VM_Profil.CheckIfOwnerAnnonce(annonce)" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <p>Aucun article en favoris</p>
                            </div>
                        }
                    }
                    else if (VM_Profil.ActiveTab == "avis")
                    {
                        <div class="reviews-header">
                            @if (!VM_Profil.IsSameUser)
                            {
                                <button class="btn-add-review" @onclick="VM_Profil.ShowAddReview">
                                    <i class="bi bi-plus-circle"></i>
                                    Ajouter un avis
                                </button>
                            }
                        </div>

                        @if (VM_Profil.IsLoadingAvis)
                        {
                            <div class="tab-loading-state">
                                <div class="spinner-medium"></div>
                                <p>Chargement des avis...</p>
                            </div>
                        }
                        else if (VM_Profil.Avis != null && VM_Profil.Avis.Any())
                        {
                            <div class="reviews-list">
                                @foreach (Shared.DTO.NoteUtilisateur.NoteUtilisateurDetailDTO avis in VM_Profil.Avis)
                                {
                                    <div class="review-item">
                                        <div class="review-header">
                                            <div class="review-user">
                                                <img class="review-avatar" src="@VM_Profil.GetPhoto(avis.PhotoProfilAuteurId)"/>
                                                <h3 class="review-name">@avis.LoginAuteur</h3>
                                            </div>
                                            <div class="review-header-right">
                                                <span class="review-date">@avis.DatePublication.ToString("dd/MM/yyyy")</span>
                        
                                                @if (!VM_Profil.IsSameUserAsReviewer(avis.NoteurId))
                                                {
                                                    <button class="btn-action" @onclick:stopPropagation @onclick="() => VM_Profil.OpenSignalerAvis(avis.NoteId)">
                                                        <i class="bi bi-flag"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        <div class="review-rating">
                                            @for (int j = 0; j < avis.Note; j++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            @for (int j = avis.Note; j < 5; j++)
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        </div>
                                        <p class="review-text">@avis.Commentaire</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <p>Aucun avis pour le moment</p>
                            </div>
                        }
                    }
                </div>
            }
        }
            
    </div>
</div>

<!-- Add Review Modal -->
@if (VM_Profil.ShowAddReviewModal)
{
    <div class="modal-overlay" @onclick="VM_Profil.CloseAddReview">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Ajouter un avis</h3>
                <button class="modal-close" @onclick="VM_Profil.CloseAddReview">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Star Rating -->
                <div class="form-group">
                    <label class="form-label">Note</label>
                    <div class="star-rating-input">
                        @for (int i = 1; i <= 5; i++)
                        {
                            int starValue = i;
                            <button type="button"
                                    class="star-btn @(starValue <= VM_Profil.SelectedRating ? "active" : "")"
                                    @onclick="() => VM_Profil.SetRating(starValue)">
                                <i class="bi bi-star-fill"></i>
                            </button>
                        }
                    </div>
                    @if (VM_Profil.SelectedRating > 0)
                    {
                        <span class="rating-text">@VM_Profil.SelectedRating / 5 étoiles</span>
                    }
                </div>

                <!-- Comment -->
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea class="form-textarea" 
                              placeholder="Partagez votre expérience avec cet utilisateur..."
                              @bind="VM_Profil.ReviewComment"
                              @bind:event="oninput"
                              rows="6"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(VM_Profil.ReviewErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@VM_Profil.ReviewErrorMessage</span>
                    </div>
                }
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_Profil.CloseAddReview">Annuler</button>
                <button class="btn-primary" @onclick="VM_Profil.SubmitReview" disabled="@VM_Profil.IsSubmittingReview">
                    @if (VM_Profil.IsSubmittingReview)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Publier l'avis</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Bloque Modal -->
@if (VM_Profil.ShowBloqueModal)
{
    <div class="modal-overlay" @onclick="VM_Profil.ToggleBloqueModal">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Bloquer l'utilisateur</h3>
                <button class="modal-close" @onclick="VM_Profil.ToggleBloqueModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="confirm-message">
                    <i class="bi bi-exclamation-circle"></i>
                    <p>Êtes-vous certain de vouloir bloquer <strong>@VM_Profil.ViewingUser.Login</strong> ?</p>
                    <p class="confirm-description">Cette personne ne pourra plus interagir avec vous.</p>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_Profil.ToggleBloqueModal">Annuler</button>
                <button class="btn-primary btn-danger" @onclick="VM_Profil.ToggleBloque" disabled="@VM_Profil.IsSubmittingBloque">
                    @if (VM_Profil.IsSubmittingBloque)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Bloquer</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
@if (VM_Profil.ShowAbonnementsModal)
{
    <div class="modal-overlay" @onclick="VM_Profil.CloseAbonnementsModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Abonnements</h3>
            </div>
            <div class="modal-body">
                @if (VM_Profil.IsLoadingAbonnements)
                {
                    <div class="loading-spinner">Chargement...</div>
                }
                else if (VM_Profil.Abonnements == null || !VM_Profil.Abonnements.Any())
                {
                    <p class="empty-message">Vous ne suivez personne pour le moment.</p>
                }
                else
                {
                    <div class="users-list">
                        @foreach (var user in VM_Profil.Abonnements)
                        {
                            <div class="user-card" @onclick="() => VM_Profil.NavigateToUserProfile(user.NomUtilisateur)">
                                <img src="@VM_Profil.GetPhoto(user.PhotoId)" alt="@user.NomUtilisateur" class="user-avatar" />
                                <div class="user-info">
                                    <span class="user-login">@("@" + user.NomUtilisateur)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
@if (VM_Profil.ShowSignalerModal)
{
    <div class="modal-overlay" @onclick="VM_Profil.ToggleSignalerModal">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Expliquez-nous la raison de votre signalement</h3>
                <button class="modal-close" @onclick="VM_Profil.ToggleSignalerModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Reason -->
                <div class="form-group">
                    <label class="form-label">Raison</label>
                    <textarea class="form-textarea"
                              placeholder="Restez civil, une vraie personne va lire votre signalement."
                              @bind="VM_Profil.SignalementRaison"
                              @bind:event="oninput"
                              rows="6"></textarea>
                </div>
                @* 
                @if (!string.IsNullOrEmpty(VM_Profil.ReviewErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@VM_Profil.ReviewErrorMessage</span>
                    </div>
                } *@
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_Profil.ToggleSignalerModal">Annuler</button>
                <button class="btn-primary" @onclick="VM_Profil.SubmitReport" disabled="@VM_Profil.IsSubmittingReport">
                    @if (VM_Profil.IsSubmittingReport)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Signaler l'utilisateur</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<Footer/>

@if (VM_Profil.ShowSignalerAvisModal)
{
    <div class="modal-overlay" @onclick="VM_Profil.ToggleSignalerAvisModal">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Expliquez-nous la raison de votre signalement</h3>
                <button class="modal-close" @onclick="VM_Profil.ToggleSignalerAvisModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Reason -->
                <div class="form-group">
                    <label class="form-label">Raison</label>
                    <textarea class="form-textarea"
                              placeholder="Restez civil, une vraie personne va lire votre signalement."
                              @bind="VM_Profil.SignalementRaison"
                              @bind:event="oninput"
                              rows="6"></textarea>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_Profil.ToggleSignalerAvisModal">Annuler</button>
                <button class="btn-primary" @onclick="VM_Profil.SubmitAvisReport" disabled="@VM_Profil.IsSubmittingReport">
                    @if (VM_Profil.IsSubmittingReport)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Signaler l'avis</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string userLogin { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await VM_Profil.LoadUserProfile(userLogin);
    }

    public void Dispose()
    {
        VM_Profil.OnStateChanged -= StateHasChanged;
    }
}


