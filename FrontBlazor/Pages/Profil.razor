@page "/profile/{userId:int}"




<PageTitle>Clothes2U</PageTitle>

<!-- Navigation Bar -->
<NavBar />

<div class="profile-page">
    <div class="profile-container">
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-avatar"></div>
            <div class="profile-info">
                @if (VM_Profil.ViewingUser != null)
                {
                    <div class="profile-top-row">

                        <h1 class="profile-name">@VM_Profil.ViewingUser.Login</h1>
                        <div class="profile-actions">
                            <button class="btn-icon">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <button class="btn-follow" @onclick="AbonnerUtilisateur">Suivre</button>
                        </div>
                    </div>
                    <div class="profile-location">
                        <i class="bi bi-geo-alt"></i>
                        <span>Annecy, France</span>
                    </div>
                    <div class="profile-stats-row">
                        <span class="profile-stat">@VM_Profil.ViewingUser.Abonnements Abonnements, @VM_Profil.ViewingUser.Abonnes Abonnés</span>
                    </div>
                    <div class="profile-member-info">
                        <span>Membre depuis @VM_Profil.ViewingUser.DateInscription </span> @*will have to somehow make it like this -> Novembre 2025 *@
                        <div class="profile-rating">
                            <i class="bi bi-star-fill"></i>
                            <span>@VM_Profil.ViewingUser.Moyenne (@VM_Profil.AvisCount)</span> @* nombre de avis grâce a get avis*@
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="profile-tabs">
            <button class="tab-btn @(VM_Profil.activeTab == "articles" ? "active" : "")" @onclick='() => VM_Profil.SetActiveTab("articles")'>
                <i class="bi bi-bag"></i>
                <span>Articles</span>
            </button>
            @* @if (userStateService.CurrentEntity.UtilisateurId == VM_Profil.ViewingUser_UserId) 
            {
                <button class="tab-btn @(VM_Profil.activeTab == "favoris" ? "active" : "")" @onclick='() => VM_Profil.SetActiveTab("favoris")'>
                    <i class="bi bi-heart"></i>
                    <span>Favoris</span>
                </button>
            } *@

            <button class="tab-btn @(VM_Profil.activeTab == "avis" ? "active" : "")" @onclick='() => VM_Profil.SetActiveTab("avis")'>
                <i class="bi bi-star"></i>
                <span>Avis</span>
            </button>

            <button class="tab-btn" @onclick='() => navigationManager.NavigateTo("/verification")'>
                Vérifier mon compte
            </button>

        </div>

        <!-- Tab Content -->
        <div class="tab-content">
            @if (VM_Profil.activeTab == "articles")
            {
                @if (VM_Profil.Annonces != null)
                {
                    <div class="products-grid">
                        @foreach (Annonce annonce in VM_Profil.Annonces)
                        {
                            <div class="product-card" @onclick="() => NavigateToProductDetail(annonce.AnnonceId)">
                                <div class="product-image-container">
                                    <div class="product-image"></div>
                                    <button class="wishlist-btn"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ToggleFavorite(annonce.AnnonceId)">
                                        <i class="bi bi-heart@(annonce.IsLikedByCurrentUser ? "-fill" : "")"></i>
                                    </button>

                                </div>

                                <div class="product-info">
                                    <h3 class="product-title">@annonce.Title</h3>

                                    <div class="product-meta">
                                        <span class="product-size">Taille @annonce.Taille</span>
                                        <span class="product-condition">@annonce.EtatArticle</span>
                                    </div>

                                    <div class="product-footer">
                                        <span class="product-price">@annonce.Prix€</span>
                                        <span class="product-seller">par @(annonce.NomAuteur ?? "Vendeur")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="filter-dropdown">
                        <button class="filter-btn">
                            <i class="bi bi-funnel"></i>
                            <span>Tous</span>
                        </button>
                    </div>
                }
                else
                {
                    if (true) @* user is not user then it should be a diff thing*@
                    {
                        <div class="empty-state">
                            <p>Vous n'avez pas encore mis en vente des articles</p>
                            <button class="btn-add-article" @onclick="AddArticle">
                                Ajouter un article
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <p>L'utilisateur n'a pas posté d'annonces'</p>
                        </div>
                    }
                    
                }
            }
            else if (VM_Profil.activeTab == "favoris")
            {
                <div class="products-grid">
                    @foreach (Annonce favoris in VM_Profil.FavorisAnnonce)
                    {
                        <div class="product-card" @onclick="() => NavigateToProductDetail(favoris.AnnonceId)">
                            <div class="product-image-container">
                                <div class="product-image"></div>
                                <button class="wishlist-btn"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleFavorite(favoris.AnnonceId)">
                                    <i class="bi bi-heart@(favoris.IsLikedByCurrentUser ? "-fill" : "")"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <h3 class="product-title">@favoris.Title</h3>

                                <div class="product-meta">
                                    <span class="product-size">Taille @favoris.Taille</span>
                                    <span class="product-condition">@favoris.EtatArticle</span>
                                </div>

                                <div class="product-footer">
                                    <span class="product-price">@favoris.Prix€</span>
                                    <span class="product-seller">par @(favoris.NomAuteur ?? "Vendeur")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="filter-dropdown">
                    <button class="filter-btn">
                        <i class="bi bi-funnel"></i>
                        <span>Tous</span>
                    </button>
                </div>
            }
            else if (VM_Profil.activeTab == "avis")
            {
                <div class="reviews-list">
                    @foreach (NoteUtilisateur avis in VM_Profil.Avis)
                    {
                        <div class="review-item">
                            <div class="review-header">
                                <div class="review-user">
                                    <div class="review-avatar"></div>
                                    <h3 class="review-name">@avis.LoginAuteur</h3>
                                </div>
                                <span class="review-date">@avis.DatePublication</span>
                            </div>
                            <div class="review-rating">
                                @for (int j = 0; j < avis.Note; j++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </div>
                            <p class="review-text">@avis.Commentaire</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int userId { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await VM_Profil.LoadUserProfile(userId);
        // show user's data
        // show user's articles
        // show user's favoris IF logged in user is the same as profile user (don't GET if not)
        // show user's reviews

    }

    public void AddArticle()
    {
        navigationManager.NavigateTo("/ajouter-article");
    }

    public async Task AbonnerUtilisateur()
    {
        await VM_Profil.ToggleAbonnement(userId);
    }

    private void NavigateToProductDetail(int? productId)
    {
        if (productId.HasValue)
        {
            navigationManager.NavigateTo($"/product/{productId}");
        }
    }

    private async Task ToggleFavorite(int annonceId)
    {
        if (VM_Connexion.CheckLoginStatus == null)
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        await VM_Profil.ToggleFavorite(annonceId);

        StateHasChanged();
    }
}