@page "/messages"
@using System.Collections.ObjectModel
@inject NavigationManager Navigation
@inject MessagerieViewModel VM_Messagerie
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Messages - Clothes2U</PageTitle>

<NavBar />

<div class="messages-page">
    <div class="messages-container">
        <!-- Left Sidebar - Conversations List -->
        <aside class="conversations-sidebar">
            <h2 class="sidebar-title">Messages</h2>
            
            <div class="conversations-list">
                @if (VM_Messagerie.IsLoading)
                {
                    <p>Chargement...</p>
                }
                else if (VM_Messagerie.Conversations != null && VM_Messagerie.Conversations.Any())
                {
                    @foreach (var conversation in VM_Messagerie.Conversations)
                    {
                        <div class="conversation-item @(VM_Messagerie.SelectedConversationId == conversation.ConversationId ? "active" : "") @(conversation.HasNewMessages ? "has-new-messages" : "")"
                             @onclick="() => OnSelectConversation(conversation.ConversationId)">
                            <div class="conversation-avatar">
                                @if (conversation.HasNewMessages)
                                {
                                    <span class="notification-badge">●</span>
                                }
                            </div>
                            <div class="conversation-info">
                                <h3 class="conversation-name">
                                    @conversation.Interlocuteur
                                    @conversation.TitreAnnonce
                                    @if (conversation.HasNewMessages)
                                    {
                                        <span class="new-indicator">Nouveau</span>
                                    }
                                </h3>
                                <p class="conversation-preview @(conversation.HasNewMessages ? "unread" : "")">
                                    @conversation.LastMessage
                                </p>
                                
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Vous n'avez pas de conversations</p>
                }
            </div>
        </aside>

        <!-- Right Side - Chat Area -->
        <div class="chat-area">
            @if (VM_Messagerie.SelectedConversation != null)
            {
                <!-- Chat Header -->
                <div class="chat-header">
                    <div class="chat-product-info">
                        <div class="product-thumbnail"></div>
                        <div>
                            <NavLink href="@($"/product/{VM_Messagerie.SelectedConversation.AnnonceId}")" class="product-link">
                                <h3 class="product-name">
                                    @VM_Messagerie.SelectedConversation.TitreAnnonce
                                    @VM_Messagerie.SelectedConversation.Interlocuteur
                                </h3>
                            </NavLink> 
                            <p class="product-price">@VM_Messagerie.SelectedConversation.Prix €</p>
                            <button class="price-proposal-btn" @onclick="() => showPriceModal = true">
                                Proposer un prix
                            </button>
                        </div>
                    </div>
                </div>

                @if (showPriceModal)
                {
                    <div class="price-popover">
                        <div class="price-popover-header">
                            <span>Proposer un prix</span>
                            <button class="close-btn" @onclick="ClosePriceModal">×</button>
                        </div>

                        <input type="number"
                               class="price-input"
                               @bind="proposedPrice"
                               min="0"
                               step="0.5"
                               placeholder="Ex : 120 €" />

                        <div class="popover-actions">
                            <button class="btn-confirm" @onclick="ConfirmPriceProposal">
                                Envoyer
                            </button>
                        </div>
                    </div>
                }

                <!-- Messages Area -->
                <div class="messages-area" @ref="messagesContainer">
                    @if (VM_Messagerie.SelectedConversation.ListMessages != null &&
                         VM_Messagerie.SelectedConversation.ListMessages.Any())
                    {
                        @foreach (var message in VM_Messagerie.SelectedConversation.ListMessages)
                        {
                            <div class="message @(message.SentByCurrentUser ? "sent" : "received")">
                                @if (message.TypeMessage == "Texte")
                                {
                                    MessageTextDTO newmessage = message as MessageTextDTO;
                                    <p class="message-text">
                                        @newmessage.Content
                                    </p>
                                    @if (newmessage.Photos != null && newmessage.Photos.Any())
                                    {
                                        @foreach (var photo in newmessage.Photos)
                                        {
                                            <img class="product-image" src="@VM_Messagerie._mediaService.GetPhotoUrl(photo)"/>
                                        }
                                    }
                                }
                                else if (message.TypeMessage == "Demande")
                                {
                                    MessageDemandeDTO demande = message as MessageDemandeDTO;
                                    
                                    <div class="price-proposal-card @(message.SentByCurrentUser ? "sent-proposal" : "received-proposal")">
                                        <!-- Icône et titre -->
                                        <div class="proposal-header">
                                            <i class="bi bi-tag-fill proposal-icon"></i>
                                            <span class="proposal-title">
                                                @if (message.SentByCurrentUser)
                                                {
                                                    <text>Proposition de prix envoyée</text>
                                                }
                                                else
                                                {
                                                    <text>Nouvelle proposition de prix</text>
                                                }
                                            </span>
                                        </div>

                                        <!-- Prix proposé vs prix original -->
                                        <div class="price-comparison">
                                            <div class="proposed-price">
                                                <span class="price-label">Prix proposé</span>
                                                <span class="price-value">@demande.PrixPropose €</span>
                                            </div>
                                            <i class="bi bi-arrow-right price-arrow"></i>
                                            <div class="original-price">
                                                <span class="price-label">Prix initial</span>
                                                <span class="price-value strikethrough">@VM_Messagerie.SelectedConversation.Prix €</span>
                                            </div>
                                        </div>

                                        <!-- Économie réalisée -->
                                        @{
                                            var savings = VM_Messagerie.SelectedConversation.Prix - demande.PrixPropose;
                                            var savingsPercent = (savings / VM_Messagerie.SelectedConversation.Prix) * 100;
                                        }
                                        @if (savings > 0)
                                        {
                                            <div class="savings-badge">
                                                <i class="bi bi-piggy-bank-fill"></i>
                                                Économie de @string.Format("{0:F2}", savings) € (-@string.Format("{0:F0}", savingsPercent)%)
                                            </div>
                                        }

                                        <!-- Statut et actions -->
                                        @if (demande.EstRepondue)
                                        {
                                            @if (demande.EstAcceptee)
                                            {
                                                <div class="proposal-status accepted">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <span>Proposition acceptée</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="proposal-status rejected">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    <span>Proposition refusée</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @if (!message.SentByCurrentUser)
                                            {
                                                <!-- Boutons d'action pour le destinataire -->
                                                <div class="proposal-actions">
                                                    <button class="btn-accept" @onclick="() => AnswerProposal(demande.MessageId.Value, true)">
                                                        <i class="bi bi-check-lg"></i>
                                                        Accepter
                                                    </button>
                                                    <button class="btn-decline" @onclick="() => AnswerProposal(demande.MessageId.Value, false)">
                                                        <i class="bi bi-x-lg"></i>
                                                        Refuser
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Message en attente pour l'envoyeur -->
                                                <div class="proposal-status pending">
                                                    <i class="bi bi-clock-fill"></i>
                                                    <span>En attente de réponse...</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                
                                <div class="message-info">
                                    <span class="message-time">@message.Date</span>
                                    @* ✅ CORRECTION ICI : IsRead au lieu de Lu *@
                                    @if (message.SentByCurrentUser && message.Lu == true)
                                    {
                                        <span class="message-read">✔✔</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="no-messages">Aucun message dans cette conversation</p>
                    }
                    
                    @* ✅ AJOUT : Indicateur de frappe *@
                    @if (VM_Messagerie.IsTyping)
                    {
                        <div class="typing-indicator">
                            <span class="typing-text">@VM_Messagerie.TypingUserName est en train d'écrire</span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                        </div>
                    }
                </div>
                

                <!-- Message Input - SECTION CORRIGÉE -->
                <div class="message-input-area">
                    <!-- Bouton upload photo avec meilleure visibilité -->
                    <div class="photo-upload-wrapper">
                        <InputFile class="hidden-file-input"
                                   id="@($"photo-input-{VM_Messagerie.SelectedConversation.ConversationId}")"
                                   OnChange="OnImageSelected"
                                   accept="image/*"
                                   multiple />
                        <label for="@($"photo-input-{VM_Messagerie.SelectedConversation.ConversationId}")" 
                               class="photo-upload-btn">
                            <i class="bi bi-image"></i>
                        </label>
                    </div>
    
                    <input type="text"
                           class="message-input"
                           placeholder="Ecrivez votre message ici..."
                           value="@VM_Messagerie.NewMessage"
                           @oninput="OnUserTypingAndUpdateMessage"
                           @onkeydown="HandleKeyPress"/>
                    <button class="send-btn" @onclick="OnSendClick">
                        <i class="bi bi-send"></i>
                    </button>
                </div>

                <!-- Preview des photos avec suppression corrigée -->
                @if (VM_Messagerie.SelectedFilePreviews.Any())
                {
                    <div class="photo-preview-container">
                        @for (int i = 0; i < VM_Messagerie.SelectedFilePreviews.Count; i++)
                        {
                            var index = i; // Capture de la variable pour le closure
                            <div class="photo-preview">
                                <img src="@VM_Messagerie.SelectedFilePreviews[i].PreviewBase64" 
                                     alt="Preview" />
                                <button type="button"
                                        class="photo-remove-btn"
                                        @onclick="() => RemovePhoto(index)"
                                        @onclick:preventDefault="true"
                                        @onclick:stopPropagation="true">
                                    ×
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-conversation">
                    <p>Sélectionnez une conversation pour commencer</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool showPriceModal = false;
    private double proposedPrice;
    private ElementReference messagesContainer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (VM_Messagerie.SelectedConversation?.ListMessages != null &&
            VM_Messagerie.SelectedConversation.ListMessages.Any())
        {
            if (messagesContainer.Context != null)
            {
                await JSRuntime.InvokeVoidAsync("ScrollHelper", messagesContainer);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await VM_Messagerie.LoadAsync();
        
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("conversationId", out var idString))
        {
            if (int.TryParse(idString, out int convId))
            {
                await VM_Messagerie.SelectConversationAsync(convId);
            }
        }
        
        VM_Messagerie.OnChange += StateHasChanged;
        VM_Messagerie.OnMessageReceivedUI += async () =>
        {
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("ScrollHelper", messagesContainer);
        };

        await VM_Messagerie.LoadConversationsAsync();
        if (VM_Messagerie.SelectedConversationId.HasValue)
        {
            await VM_Messagerie.SelectConversationAsync(VM_Messagerie.SelectedConversationId.Value);
        }
    }

    public void Dispose()
    {
        VM_Messagerie.OnChange -= StateHasChanged;
        VM_Messagerie.OnMessageReceivedUI -= null;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (!string.IsNullOrWhiteSpace(VM_Messagerie.NewMessage)|| VM_Messagerie.SelectedFile != null))
        {
            await VM_Messagerie.SendMessageAsync();
            StateHasChanged();
        }
    }

    private async Task OnSendClick()
    {
        if (!string.IsNullOrWhiteSpace(VM_Messagerie.NewMessage) || VM_Messagerie.SelectedFile != null)
        {
            await VM_Messagerie.SendMessageAsync();
            StateHasChanged();
        }
    }

    private async Task OnSelectConversation(int id)
    {
        Console.WriteLine($"[Page] 🖱️ OnSelectConversation clicked: {id}");
        await VM_Messagerie.SelectConversationAsync(id);
        Console.WriteLine($"[Page] ✅ Conversation {id} selected");
        StateHasChanged();
    }
    
    private void OnUserTypingAndUpdateMessage(ChangeEventArgs e)
    {
        // Mettre à jour le message
        VM_Messagerie.NewMessage = e.Value?.ToString() ?? "";
        
        // Notifier que l'utilisateur est en train d'écrire
        VM_Messagerie.HandleTyping(new KeyboardEventArgs());
    }
    
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        await VM_Messagerie.OnImagesSelectedAsync(e);
    }
    
    private void RemovePhoto(int index)
    {
        Console.WriteLine($"[Page] 🗑️ Removing photo at index {index}");
        VM_Messagerie.RemoveSelectedPhotoAt(index);
        StateHasChanged();
    }
    
    private void ClosePriceModal()
    {
        showPriceModal = false;
        proposedPrice = 0;
    }

    private void ConfirmPriceProposal()
    {
        if (proposedPrice > 0)
        {
            VM_Messagerie.SendProposition(proposedPrice);
            StateHasChanged();
            ClosePriceModal();
        }
    }
    
    // À ajouter dans la section @code de Messages.razor

    private async Task AnswerProposal(int messageId, bool answer)
    {
        try
        {
            await VM_Messagerie.AnswerPriceProposal(messageId, answer);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Page] ❌ Error accepting proposal: {ex.Message}");
            // Optionnel : afficher un message d'erreur à l'utilisateur
        }
    }

    // private async Task DeclineProposal(int messageId)
    // {
