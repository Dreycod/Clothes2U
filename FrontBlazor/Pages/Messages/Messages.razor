@page "/messages"
@layout ClientLayout
@inject NavigationManager Navigation
@inject MessagerieViewModel VM_Messagerie
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Messages - Clothes2U</PageTitle>

@*<NavBar />*@

<div class="messages-page">
    <div class="messages-container">
        <!-- Left Sidebar - Conversations List -->
        <aside class="conversations-sidebar">
            <h2 class="sidebar-title">Messages</h2>
            
            <div class="conversations-list">
                @if (VM_Messagerie.IsLoading)
                {
                    <p>Chargement...</p>
                }
                else //if (VM_Messagerie.Conversations != null && VM_Messagerie.Conversations.Any())
                {
                    <div class="sidebar-filters">
                        <select class="status-filter" @bind="VM_Messagerie.StatusFilter">
                            <option value="Tous">Toutes Les Conversations</option>
                            @foreach (var status in VM_Messagerie.StatutConversation)
                            {
                                <option value="@status.StatutConversationLibelle">@status.StatutConversationLibelle</option>
                            }
                        </select>
                    </div>
                    
                    @if (!VM_Messagerie.GetFilterConversation().Any())
                    {
                        <div class="sidebar-empty">
                           <p>Aucune Conversation</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var conversation in VM_Messagerie.GetFilterConversation())
                        {
                            <div class="conversation-item @(VM_Messagerie.SelectedConversationId == conversation.ConversationId ? "active" : "") @(conversation.HasNewMessages ? "has-new-messages" : "")"
                                 @onclick="() => OnSelectConversation(conversation.ConversationId)">
                                <div class="conversation-avatar">
                                    @if (conversation.PhotoAnnonceId.HasValue && conversation.PhotoAnnonceId.Value != 0)
                                    {
                                        <img src="@VM_Messagerie._mediaService.GetPhotoUrl(conversation.PhotoAnnonceId.Value)" alt="Photo de l'annonce" />
                                    }
                                    else
                                    {
                                        <img src="images/placeholder_annonce.png"
                                             alt="Photo interlocuteur" />
                                    }
                                    @if (conversation.HasNewMessages)
                                    {
                                        <span class="notification-badge">●</span>
                                    }
                                </div>
                                <div class="conversation-info">
                                    <h3 class="conversation-name">
                                        <span class="conversation-title">@conversation.TitreAnnonce</span>
                                        <span class="conversation-interlocuteur">@conversation.Interlocuteur</span>
                                        
                                        @if (conversation.HasNewMessages)
                                        {
                                            <span class="new-indicator">Nouveau</span>
                                        }
                                        
                                    </h3>
                                    <p class="conversation-preview @(conversation.HasNewMessages ? "unread" : "")">
                                        @if (conversation.ListMessages != null && conversation.ListMessages.Any())
                                        {
                                            var lastMessage = conversation.ListMessages.Last();
                                            if (lastMessage.TypeMessage == "Demande")
                                            {
                                                <i class="bi bi-tag-fill"></i>
                                                <span>Nouvelle proposition de prix</span>
                                            }
                                        }
                                        @conversation.LastMessage
                                    </p>
                                    
                                </div>
                            </div>
                        }
                    }
                    
                }
                @* else *@
                @* { *@
                @*     <p>Vous n'avez pas de conversations</p> *@
                @* } *@
            </div>
        </aside>

        <!-- Right Side - Chat Area -->
        <div class="chat-area">
            @if (VM_Messagerie.SelectedConversation != null)
            {
                <!-- Chat Header -->
                <div class="chat-header">
                    <div class="chat-product-info">
                        <div class="product-thumbnail">
                            @if (VM_Messagerie.SelectedConversation.PhotoAnnonceId.HasValue && VM_Messagerie.SelectedConversation.PhotoAnnonceId.Value != 0)
                            {
                                <img src="@VM_Messagerie._mediaService.GetPhotoUrl(VM_Messagerie.SelectedConversation.PhotoAnnonceId.Value)" alt="Photo de l'annonce" />
                            }
                            else
                            {
                                <img src="images/placeholder_annonce.png"
                                     alt="Photo interlocuteur" />
                            }
                        </div>
                        <div>
                            @if (VM_Messagerie.SelectedConversation.AnnonceId.HasValue)
                            {
                                <NavLink href="@($"/product/{VM_Messagerie.SelectedConversation.AnnonceId.Value}")" class="product-link">
                                    <h3 class="product-name">
                                        @VM_Messagerie.SelectedConversation.TitreAnnonce
                                        @VM_Messagerie.SelectedConversation.Interlocuteur
                                    </h3>
                                </NavLink>
                            }
                            else
                            {
                                <h3 class="product-name">
                                    @VM_Messagerie.SelectedConversation.TitreAnnonce
                                    @VM_Messagerie.SelectedConversation.Interlocuteur
                                </h3>
                            }
                            <div class="chat-price-info">
                                <span class="price-label">Prix</span>

                                @if (VM_Messagerie.SelectedConversation.Prix != VM_Messagerie.SelectedConversation.PrixAnnonce)
                                {
                                    <span class="price-original">
                                        @VM_Messagerie.SelectedConversation.PrixAnnonce €
                                    </span>
                                    <i class="bi bi-arrow-right"></i>
                                    <span class="price-current">
                                        @VM_Messagerie.SelectedConversation.Prix €
                                    </span>
                                }
                                else
                                {
                                    <span class="price-current">
                                        @VM_Messagerie.SelectedConversation.Prix €
                                    </span>
                                }
                            </div>
                            
                            @if (VM_Messagerie.utilisateur != null && 
                                 VM_Messagerie.SelectedConversation.VendeurId != null &&
                                 VM_Messagerie.utilisateur.UtilisateurId != VM_Messagerie.SelectedConversation.VendeurId)
                            {
                                <NavLink class="buy-button"
                                         href="@($"/acheter/{VM_Messagerie.SelectedConversationId}")">
                                    <i class="bi bi-bag-check-fill"></i>
                                    Acheter
                                </NavLink>
                            }

                            @if (VM_Messagerie.SelectedConversation.Negociable)
                            {
                                <button class="price-proposal-btn" @onclick="() => showPriceModal = true">
                                    Proposer un prix
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @if (showPriceModal)
                {
                    <div class="price-popover">
                        <div class="price-popover-header">
                            <span>Proposer un prix</span>
                            <button class="close-btn" @onclick="ClosePriceModal">×</button>
                        </div>

                        <input type="number"
                               class="price-input"
                               @bind="proposedPrice"
                               min="0"
                               step="0.5"
                               placeholder="Ex : 120 €" />

                        <div class="popover-actions">
                            <button class="btn-confirm" @onclick="ConfirmPriceProposal">
                                Envoyer
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(VM_Messagerie.PriceProposalError))
                        {
                            <div class="price-error-message">
                                @VM_Messagerie.PriceProposalError
                            </div>
                        }
                    </div>
                }

                <!-- Messages Area -->
                <div class="messages-area" @ref="messagesContainer">
                    @if (VM_Messagerie.SelectedConversation.ListMessages != null &&
                         VM_Messagerie.SelectedConversation.ListMessages.Any())
                    {
                        @foreach (var message in VM_Messagerie.SelectedConversation.ListMessages)
                        {
                            <div class="message @(message.SentByCurrentUser ? "sent" : "received")">
                                @if (!message.SentByCurrentUser)
                                {
                                    <div class="message-avatar">
                                        @if (VM_Messagerie.SelectedConversation.PhotoInterlocuteurId.HasValue &&
                                             VM_Messagerie.SelectedConversation.PhotoInterlocuteurId.Value != 0)
                                        {
                                            <img src="@VM_Messagerie._mediaService.GetPhotoUrl(VM_Messagerie.SelectedConversation.PhotoAnnonceId.Value)"
                                                 alt="Photo interlocuteur"/>
                                        }
                                        else
                                        {
                                            <img src="images/placeholder_message.jpeg"
                                                 alt="Photo interlocuteur"/>
                                        }
                                    </div>
                                }
                                @if (message.TypeMessage == "Texte")
                                {
                                    MessageTextDTO newmessage = message as MessageTextDTO;
                                    <div class="message-content-wrapper">
                                        <p class="message-text">
                                            @newmessage.Content
                                        </p>
                                        @if (!newmessage.SentByCurrentUser && newmessage.MessageId.HasValue)
                                        {
                                            <button class="btn-report-message" @onclick="() => VM_Messagerie.OpenReportModal(newmessage.MessageId.Value)" title="Signaler ce message">
                                                <i class="bi bi-flag"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (newmessage.Photos != null && newmessage.Photos.Any())
                                    {
                                        @foreach (var photo in newmessage.Photos)
                                        {
                                            <img class="product-image" src="@VM_Messagerie._mediaService.GetPhotoUrl(photo)"/>
                                        }
                                    }
                                }
                                else if (message.TypeMessage == "Demande")
                                {
                                    MessageDemandeDTO demande = message as MessageDemandeDTO;

                                    <div class="price-proposal-card @(message.SentByCurrentUser ? "sent-proposal" : "received-proposal")">
                                        <!-- Icône et titre -->
                                        <div class="proposal-header">
                                            <i class="bi bi-tag-fill proposal-icon"></i>
                                            <span class="proposal-title">
                                                @if (message.SentByCurrentUser)
                                                {
                                                    <text>Proposition de prix envoyée</text>
                                                }
                                                else
                                                {
                                                    <text>Nouvelle proposition de prix</text>
                                                }
                                            </span>
                                        </div>

                                        <!-- Prix proposé vs prix original -->
                                        <div class="price-comparison">
                                            <div class="original-price">
                                                <span class="price-label">Prix initial</span>
                                                <span class="price-value strikethrough">@VM_Messagerie.SelectedConversation.PrixAnnonce €</span>
                                            </div>
                                            <i class="bi bi-arrow-right price-arrow"></i>
                                            <div class="proposed-price">
                                                <span class="price-label">Prix proposé</span>
                                                <span class="price-value">@demande.PrixPropose €</span>
                                            </div>
                                        </div>

                                        <!-- Économie réalisée -->
                                        @{
                                            var savings = VM_Messagerie.SelectedConversation.Prix - demande.PrixPropose;
                                            var savingsPercent = (savings / VM_Messagerie.SelectedConversation.Prix) * 100;
                                        }
                                        @if (savings > 0)
                                        {
                                            <div class="savings-badge">
                                                <i class="bi bi-piggy-bank-fill"></i>
                                                Économie de @string.Format("{0:F2}", savings) € (-@string.Format("{0:F0}", savingsPercent)%)
                                            </div>
                                        }

                                        <!-- Statut et actions -->
                                        @if (demande.EstRepondue)
                                        {
                                            @if (demande.EstAcceptee)
                                            {
                                                <div class="proposal-status accepted">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <span>Proposition acceptée</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="proposal-status rejected">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    <span>Proposition refusée</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @if (!message.SentByCurrentUser)
                                            {
                                                <!-- Boutons d'action pour le destinataire -->
                                                <div class="proposal-actions">
                                                    <button class="btn-accept" @onclick="() => AnswerProposal(demande.MessageId.Value, true)">
                                                        <i class="bi bi-check-lg"></i>
                                                        Accepter
                                                    </button>
                                                    <button class="btn-decline" @onclick="() => AnswerProposal(demande.MessageId.Value, false)">
                                                        <i class="bi bi-x-lg"></i>
                                                        Refuser
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Message en attente pour l'envoyeur -->
                                                <div class="proposal-status pending">
                                                    <i class="bi bi-clock-fill"></i>
                                                    <span>En attente de réponse...</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else if (message.TypeMessage == "Payee")
                                {
                                    MessageEstPayeeDTO payee = message as MessageEstPayeeDTO;

                                    <div class="payment-status-card @(payee.EstAnnule ? "cancelled" : "paid")">
                                        <div class="payment-icon">
                                            @if (payee.EstAnnule)
                                            {
                                                <i class="bi bi-x-circle-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-circle-fill"></i>
                                            }
                                        </div>

                                        <div class="payment-content">
                                            @if (payee.EstAnnule)
                                            {
                                                <h4>Paiement annulé</h4>
                                                <p>La transaction a été annulée.</p>
                                            }
                                            else
                                            {
                                                <h4>Produit payé</h4>
                                                
                                                @if (!payee.EstEnvoye)
                                                {
                                                    <p>En attente d’envoi du colis par le vendeur.</p>
                                                }
                                                else
                                                {
                                                    <p>Le colis a été envoyé.</p>
                                                }
                                                <a class="btn btn-outline-primary mt-2"
                                                   href="/orders?orderId=@payee.OrderId">
                                                    <i class="bi bi-receipt"></i>
                                                    Voir la commande
                                                </a>
                                            }
                                            
                                            
                                            @* Bouton visible uniquement pour le vendeur tant que le colis n'est pas envoyé *@
                                            @if (!payee.EstAnnule &&
                                                 !payee.EstEnvoye &&
                                                 VM_Messagerie.utilisateur != null &&
                                                 VM_Messagerie.SelectedConversation.VendeurId != null &&
                                                 VM_Messagerie.utilisateur.UtilisateurId == VM_Messagerie.SelectedConversation.VendeurId)
                                            {
                                                <div class="mt-2">

                                                    <InputFile OnChange="VM_Messagerie.OnColisPhotoSelected"
                                                               accept="image/*" />

                                                    @if (VM_Messagerie.ColisPhotoPreviewBase64 != null)
                                                    {
                                                        <img src="@VM_Messagerie.ColisPhotoPreviewBase64"
                                                             class="img-thumbnail mt-2"
                                                             style="max-width:200px" />
                                                    }

                                                    @if (!string.IsNullOrEmpty(VM_Messagerie.ColisError))
                                                    {
                                                        <div class="text-danger mt-1">
                                                            @VM_Messagerie.ColisError
                                                        </div>
                                                    }

                                                    <button class="btn btn-primary mt-3"
                                                            disabled="@VM_Messagerie.IsSendingColis"
                                                            @onclick="() => VM_Messagerie.MarquerColisEnvoyeAsync(payee.MessageEstPayeeId)">
                                                        <i class="bi bi-truck"></i>
                                                        Marquer comme envoyé
                                                    </button>

                                                </div>
                                            }
                                            
                                            @* Bouton annuler visible pour l'acheteur tant que le colis n'est pas envoyé *@
                                            @if (!payee.EstAnnule &&
                                                 !payee.EstEnvoye &&
                                                 VM_Messagerie.utilisateur != null &&
                                                 VM_Messagerie.SelectedConversation.VendeurId != null &&
                                                 VM_Messagerie.utilisateur.UtilisateurId != VM_Messagerie.SelectedConversation.VendeurId)
                                            {
                                                <button class="btn-secondary btn-danger"
                                                        @onclick="() => CancelPayement(payee.MessageEstPayeeId)">
                                                    <i class="bi bi-x-circle"></i>
                                                    Annuler
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (message.TypeMessage == "EnvoieColis")
                                {
                                    MessageEnvoieColisDTO colis = message as MessageEnvoieColisDTO;

                                    <div class="payment-status-card paid">
                                        <div class="payment-icon">
                                            <i class="bi bi-truck"></i>
                                        </div>

                                        <div class="payment-content">
                                            <h4>Colis envoyé</h4>
                                            <p>Le vendeur a expédié le colis.</p>

                                            @if (colis.PhotoId != null && colis.PhotoId != 0)
                                            {
                                                <img src="@VM_Messagerie._mediaService.GetPhotoUrl(colis.PhotoId)"
                                                     alt="Preuve d'envoi du colis"
                                                     style="margin-top:10px; max-width:220px; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.15);" />
                                            }
                                        
                                        @if ((!colis.MessageEstRecuId.HasValue || colis.MessageEstRecuId.Value == 0) && 
                                             VM_Messagerie.utilisateur != null &&
                                             VM_Messagerie.SelectedConversation.VendeurId != null&&
                                             VM_Messagerie.utilisateur.UtilisateurId != VM_Messagerie.SelectedConversation.VendeurId)
                                        {
                                            <div class="colis-reception-card">
                                                <h4>📦 Avez-vous reçu le colis ?</h4>
                                        
                                                <div class="reception-actions">
                                                    <button class="btn-accept" 
                                                            @onclick="() => VM_Messagerie.OuvrirModalReception(true, colis.MessageEnvoieColisId)">
                                                        <i class="bi bi-check-circle"></i>
                                                        Conforme
                                                    </button>
                                            
                                                    <button class="btn-decline" 
                                                            @onclick="() => VM_Messagerie.OuvrirModalReception(false, colis.MessageEnvoieColisId)">
                                                        <i class="bi bi-x-circle"></i>
                                                        Non conforme
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        </div>
                                    </div>
                                }

                                else if (message.TypeMessage == "Recu")
                                {
                                    MessageEstRecuDTO recu = message as MessageEstRecuDTO;

                                    <div class="payment-status-card @(recu.EstConforme ? "paid" : "cancelled")">
                                        <div class="payment-icon">
                                            @if (recu.EstConforme)
                                            {
                                                <i class="bi bi-check-circle-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                            }
                                        </div>

                                        <div class="payment-content">
                                            @if (recu.EstConforme)
                                            {
                                                <h4>✅ Colis reçu et conforme</h4>
                                                <p>L'acheteur a confirmé la réception du colis.</p>
                                            }
                                            else
                                            {
                                                <h4>⚠️ Colis non conforme</h4>
                                                <p>L'acheteur a signalé un problème avec le colis.</p>
                                                
                                                @if (!string.IsNullOrEmpty(recu.Description))
                                                {
                                                    <div class="reception-description">
                                                        <strong>Description :</strong>
                                                        <p>@recu.Description</p>
                                                    </div>
                                                }
                                                
                                                @if (recu.PhotoId.HasValue && recu.PhotoId.Value != 0)
                                                {
                                                    <img src="@VM_Messagerie._mediaService.GetPhotoUrl(recu.PhotoId.Value)"
                                                         alt="Photo du problème"
                                                         style="margin-top:10px; max-width:220px; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.15);" />
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="message-info">
                                    <span class="message-time">@message.Date</span>
                                    @* ✅ CORRECTION ICI : IsRead au lieu de Lu *@
                                    @if (message.SentByCurrentUser && message.Lu == true)
                                    {
                                        <span class="message-read">✔✔</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="no-messages">Aucun message dans cette conversation</p>
                    }
                    
                    @* ✅ AJOUT : Indicateur de frappe *@
                    @if (VM_Messagerie.IsTyping)
                    {
                        <div class="typing-indicator">
                            <span class="typing-text">@VM_Messagerie.TypingUserName est en train d'écrire</span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                        </div>
                    }
                </div>
                

                <!-- Message Input - SECTION CORRIGÉE -->
                <div class="message-input-area">
                    <!-- Bouton upload photo avec meilleure visibilité -->
                    <div class="photo-upload-wrapper">
                        <InputFile class="hidden-file-input" style="display: none"
                                   id="@($"photo-input-{VM_Messagerie.SelectedConversation.ConversationId}")"
                                   OnChange="OnImageSelected"
                                   accept="image/*"
                                   multiple />
                        <label for="@($"photo-input-{VM_Messagerie.SelectedConversation.ConversationId}")" 
                               class="photo-upload-btn">
                            <i class="bi bi-image"></i>
                        </label>
                    </div>
    
                    <input type="text"
                           class="message-input"
                           placeholder="Ecrivez votre message ici..."
                           value="@VM_Messagerie.NewMessage"
                           @oninput="OnUserTypingAndUpdateMessage"
                           @onkeydown="HandleKeyPress"/>
                    <button class="send-btn" @onclick="OnSendClick">
                        <i class="bi bi-send"></i>
                    </button>
                </div>

                <!-- Preview des photos avec suppression corrigée -->
                @if (VM_Messagerie.SelectedFilePreviews.Any())
                {
                    <div class="photo-preview-container">
                        @for (int i = 0; i < VM_Messagerie.SelectedFilePreviews.Count; i++)
                        {
                            var index = i; // Capture de la variable pour le closure
                            <div class="photo-preview">
                                <img src="@VM_Messagerie.SelectedFilePreviews[i].PreviewBase64" 
                                     alt="Preview" />
                                <button type="button"
                                        class="photo-remove-btn"
                                        @onclick="() => RemovePhoto(index)"
                                        @onclick:preventDefault="true"
                                        @onclick:stopPropagation="true">
                                    ×
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-conversation">
                    <p>Sélectionnez une conversation pour commencer</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Réception Colis -->
@if (VM_Messagerie.ShowReceptionModal)
{
    <div class="modal-overlay" @onclick="() => VM_Messagerie.FermerModalReception()">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>
                    @if (VM_Messagerie.ColisEstConforme)
                    {
                        <text>✅ Confirmer la réception</text>
                    }
                    else
                    {
                        <text>⚠️ Signaler un problème</text>
                    }
                </h3>
                <button class="modal-close" @onclick="() => VM_Messagerie.FermerModalReception()">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (VM_Messagerie.ColisEstConforme)
                {
                    <div class="confirm-message">
                        <i class="bi bi-check-circle"></i>
                        <p>Confirmez-vous que le colis est conforme à la description ?</p>
                        <p class="confirm-description">Cette action finalisera la transaction.</p>
                    </div>
                }
                else
                {
                    <div class="confirm-message">
                        <i class="bi bi-exclamation-triangle"></i>
                        <p>Décrivez le problème rencontré avec le colis</p>
                        <p class="confirm-description">Ajoutez une photo et une description détaillée.</p>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Photo du problème *</label>
                        <InputFile OnChange="VM_Messagerie.OnReceptionPhotoSelected"
                                   accept="image/*" 
                                   class="form-input" />

                        @if (VM_Messagerie.ReceptionPhotoPreviewBase64 != null)
                        {
                            <img src="@VM_Messagerie.ReceptionPhotoPreviewBase64"
                                 class="img-thumbnail mt-2"
                                 style="max-width:200px" />
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label">Description du problème *</label>
                        <textarea class="form-textarea"
                                  placeholder="Décrivez précisément le problème rencontré..."
                                  @bind="VM_Messagerie.ReceptionDescription"
                                  @bind:event="oninput"
                                  rows="5">
                        </textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(VM_Messagerie.ReceptionError))
                    {
                        <div class="alert alert-error">
                            <i class="bi bi-exclamation-triangle"></i>
                            <p>@VM_Messagerie.ReceptionError</p>
                        </div>
                    }
                }
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="() => VM_Messagerie.FermerModalReception()">
                    Annuler
                </button>

                <button class="btn-primary @(VM_Messagerie.ColisEstConforme ? "" : "btn-danger")"
                        @onclick="async () => await VM_Messagerie.ConfirmerReceptionColisAsync()"
                        disabled="@VM_Messagerie.IsSendingReception">
                    @if (VM_Messagerie.IsSendingReception)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Confirmer</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Report Message Modal -->
@if (VM_Messagerie.ShowReportModal)
{
    <div class="modal-overlay" @onclick="() => VM_Messagerie.CloseReportModal()">
        <div class="modal-content review-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Signaler le message</h3>
                <button class="modal-close" @onclick="() => VM_Messagerie.CloseReportModal()">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="confirm-message">
                    <i class="bi bi-exclamation-triangle"></i>
                    <p>Expliquez-nous la raison de votre signalement</p>
                    <p class="confirm-description">Notre équipe examinera le contenu signalé.</p>
                </div>

                @if (!string.IsNullOrEmpty(VM_Messagerie.ReportingMessageContent))
                {
                    <div class="reported-message-preview">
                        <label class="form-label">Message signalé :</label>
                        <div class="message-preview-box">
                            @VM_Messagerie.ReportingMessageContent
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Raison du signalement</label>
                    <textarea class="form-textarea"
                              placeholder="Restez civil, une vraie personne va lire votre signalement."
                              @bind="VM_Messagerie.SignalementRaison"
                              @bind:event="oninput"
                              rows="5">
                    </textarea>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="() => VM_Messagerie.CloseReportModal()">Annuler</button>

                <button class="btn-primary btn-danger"
                        @onclick="async () => await VM_Messagerie.ConfirmReportMessageAsync()"
                        disabled="@VM_Messagerie.IsSubmittingReport">
                    @if (VM_Messagerie.IsSubmittingReport)
                    {
                        <span class="spinner-small-inline"></span>
                        <span>Envoi...</span>
                    }
                    else
                    {
                        <span>Signaler</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

