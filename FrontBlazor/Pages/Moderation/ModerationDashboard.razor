@page "/moderation"
@inject ModerationBoardViewModel moderationViewModel
@layout ModerationLayout
@using FrontBlazor.Components.Moderation;
<link href="css/loading.css" rel="stylesheet" />
<link href="css/Moderation/moderation-shared.css" rel="stylesheet"/>

<PageTitle>Modération - Clothes2U</PageTitle>


@if (moderationViewModel.IsLoading)
{
    <div class="loader"></div>
}
else
{
    <ModerationBasePage ViewModel="moderationViewModel">
        <link rel="stylesheet" href="/css/moderation-shared.css" />
        
        <h1 class="mod-page-title">Tableau de bord</h1>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon red">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
                <div class="stat-info">
                    <h3>@moderationViewModel.DashBoardStatistics.SignalementsEnAttented</h3>
                    <p>Signalements en attente</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="bi bi-person-slash"></i>
                </div>
                <div class="stat-info">
                    <h3>@moderationViewModel.DashBoardStatistics.CompteSuspendus</h3>
                    <p>Comptes suspendus</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-person-check"></i>
                </div>
                <div class="stat-info">
                    <h3>@moderationViewModel.DashBoardStatistics.ResaurationEnAttente</h3>
                    <p>Restaurations en attente</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon cyan">
                    <i class="bi bi-chat-dots"></i>
                </div>
                <div class="stat-info">
                    <h3>@moderationViewModel.DashBoardStatistics.DemandeSupport</h3>
                    <p>Demandes de support</p>
                </div>
            </div>
        </div>
        @if (moderationViewModel.Activity.Count > 0)
        {
            <div class="recent-section">
                <h2 class="section-title">Activité récente</h2>
            
                <div class="activity-list">
                    @foreach(ActivityDTO activity in moderationViewModel.Activity)
                    {
                        <ActivityComponent
                            Activity="activity"
                            VM_Board="moderationViewModel"
                        ></ActivityComponent>
                    }
                </div>
            </div>
        }
        <!-- Quick Stats -->
        <div class="quick-stats-section">
            <h2 class="section-title">Statistiques</h2>

            <div class="quick-stats-grid">
                <div class="quick-stat">
                    <h4>Aujourd'hui</h4>
                    @if (moderationViewModel.DashBoardStatistics.DecisionsAujourdhui.SignalementsTraites > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsAujourdhui.SignalementsTraites signalements traités</p>
                    }
                    @if (moderationViewModel.DashBoardStatistics.DecisionsAujourdhui.ComptesSuspendus > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsAujourdhui.ComptesSuspendus comptes suspendus</p>
                    }
                    @if (moderationViewModel.DashBoardStatistics.DecisionsAujourdhui.ComptesBannis > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsAujourdhui.ComptesBannis Comptes bannis</p>
                    }
                </div>
                <div class="quick-stat">
                    <h4>Cette semaine</h4>
                    @if (moderationViewModel.DashBoardStatistics.DecisionsSemaine.SignalementsTraites > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsSemaine.SignalementsTraites signalements traités</p>
                    }
                    @if (moderationViewModel.DashBoardStatistics.DecisionsSemaine.ComptesSuspendus > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsSemaine.ComptesSuspendus comptes suspendus</p>
                    }
                    @if (moderationViewModel.DashBoardStatistics.DecisionsSemaine.ComptesBannis > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsSemaine.ComptesBannis Comptes bannis</p>
                    }
                </div>
                <div class="quick-stat">
                    <h4>Ce mois</h4>
                    @if (moderationViewModel.DashBoardStatistics.DecisionsMois.SignalementsTraites > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsMois.SignalementsTraites signalements traités</p>
                    }
                    @if (moderationViewModel.DashBoardStatistics.DecisionsMois.ComptesSuspendus > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsMois.ComptesSuspendus comptes suspendus</p>
                    }
                    @if (moderationViewModel.DashBoardStatistics.DecisionsMois.ComptesBannis > 0)
                    {
                        <p>@moderationViewModel.DashBoardStatistics.DecisionsMois.ComptesBannis Comptes bannis</p>
                    }
                </div>
            </div>
        </div>
    </ModerationBasePage>
}




@code{
    protected override async Task OnInitializedAsync()
    {
        await moderationViewModel.LoadAsync();
    }

    

}