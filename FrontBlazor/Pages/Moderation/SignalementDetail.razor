@page "/moderation/signalements/{id:int}"
@using FrontBlazor.ViewModel.Moderation.Signalements
@inject TraitementSignalementViewModel VM_traitementSignalement
@layout ModerationLayout


<PageTitle>Détail du signalement - Modération</PageTitle>


<link rel="stylesheet" href="/css/moderation-shared.css" />
<link href="css/loading.css" rel="stylesheet" />

@if (VM_traitementSignalement.IsLoading)
{
    <div class="loader"></div>
}
else
{
    <div>
        <div>
            <p>@VM_traitementSignalement.avis.LoginAuteur</p>
        </div>
        <div>
            
        </div>
    </div>
}
@code {
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await VM_traitementSignalement.LoadSignalementAsync(Id);
    }
}