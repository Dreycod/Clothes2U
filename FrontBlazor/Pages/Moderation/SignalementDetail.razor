@page "/moderation/signalements/{id:int}"
@using FrontBlazor.ViewModel.Moderation.Signalements
@using FrontBlazor.Components.Moderation
@inject TraitementSignalementViewModel VM_traitementSignalement
@layout ModerationLayout


<PageTitle>Détail du signalement - Modération</PageTitle>


<link rel="stylesheet" href="/css/moderation-shared.css" />
<link href="css/loading.css" rel="stylesheet" />

@if (VM_traitementSignalement.IsLoading)
{
    <div class="loader"></div>
}
else
{
    <div>
        <div id="content_board">
            @switch (VM_traitementSignalement.Signalement)
            {
                case SignalementAnnonce signalementAnnonce:
                    <p>@VM_traitementSignalement.Annonce.Title</p>
                    break;
                case SignalementAvis signalementAvis :
                    <p>@VM_traitementSignalement.Avis.Commentaire</p>
                    break;
                case SignalementUtilisateur signalementUtilisateur:
                    <p>@VM_traitementSignalement.UtilisateurSignale.Login</p>
                    break;
            }
        </div>
        <div id="decision-board">
            <DecisionBoard 
                VM_Traitement = "@VM_traitementSignalement"
                ></DecisionBoard>
        </div>
    </div>
}
@code {
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await VM_traitementSignalement.LoadSignalementAsync(Id);
    }
}