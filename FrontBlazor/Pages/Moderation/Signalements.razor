﻿@page "/moderation/signalements"
@using FrontBlazor.ViewModel.Moderation
@inject SignalementViewModel SignalementViewModel
@layout ModerationLayout

<PageTitle>Signalements - Modération</PageTitle>

<link href="css/Moderation/moderation-shared.css" rel="stylesheet"/>
<link href="css/loading.css" rel="stylesheet" />

@if (SignalementViewModel.IsLoading)
{
    <div class="loader"></div>
}
else
{
    <h1 class="mod-page-title">Signalements</h1>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        <button class="filter-tab @(SignalementViewModel.SelectedCategoryId == 0 ? "active" : "")" 
                @onclick='() => SignalementViewModel.ChangeCategory(0)'>
            Tous
        </button>
        <button class="filter-tab @(SignalementViewModel.SelectedCategoryId == 1 ? "active" : "")" 
                @onclick='() => SignalementViewModel.ChangeCategory(1)'>
            Comptes
        </button>
        <button class="filter-tab @(SignalementViewModel.SelectedCategoryId == 2 ? "active" : "")" 
                @onclick='() => SignalementViewModel.ChangeCategory(2)'>
            Posts
        </button>
        <button class="filter-tab @(SignalementViewModel.SelectedCategoryId == 4 ? "active" : "")" 
                @onclick='() => SignalementViewModel.ChangeCategory(4)'>
            Messages privés
        </button>
        <button class="filter-tab @(SignalementViewModel.SelectedCategoryId == 3 ? "active" : "")" 
                @onclick='() => SignalementViewModel.ChangeCategory(3)'>
            Avis
        </button>
    </div>
    
    <div class="reports-container">
        @if (SignalementViewModel.Signalements.Any())
        {
            @foreach(var signalement in SignalementViewModel.Signalements)
            {
                <div class="report-card">
                    <div class="report-header">
                        <div class="report-user">
                            @if (signalement.PhotoProfilUtilisateurId.HasValue)
                            {
                                string value = signalement.PhotoProfilUtilisateurId.ToString();
                                <img class="report-avatar" src="http://localhost:5096/api/Medias/Photo/ + value" alt="Avatar" />
                            }
                            else
                            {
                                <div class="report-avatar"></div>
                            }
                            <div>
                                <h3>@signalement.LoginUtilisateurSignale</h3>
                                <p class="report-reason">a été signalé pour <span class="reason-highlight">@signalement.SignalementMotif</span></p>
                            </div>
                        </div>
                        <button class="btn-view" @onclick="() => SignalementViewModel.VoirSignalement(signalement.SignalementId)">
                            Visualiser
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="no-results">Aucun signalement trouvé pour cette catégorie.</p>
        }
    </div>
}

