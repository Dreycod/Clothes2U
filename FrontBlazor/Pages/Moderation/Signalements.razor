﻿@page "/moderation/signalements"
@rendermode InteractiveServer

<PageTitle>Signalements - Modération</PageTitle>

<link rel="stylesheet" href="/css/moderation-shared.css" />

<div class="moderation-page">
    <div class="moderation-container">
        <!-- Sidebar (same as dashboard) -->
        <aside class="mod-sidebar">
            <div class="mod-header">
                <div class="mod-logo">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <h2>Clothes2U</h2>
                        <p>Moderation Board</p>
                    </div>
                </div>
            </div>

            <nav class="mod-nav">
                <a href="/moderation" class="mod-nav-item">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
                <a href="/moderation/signalements" class="mod-nav-item active">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>Signalements</span>
                </a>
                <a href="/moderation/images" class="mod-nav-item">
                    <i class="bi bi-image"></i>
                    <span>Images</span>
                </a>
                <a href="/moderation/restauration" class="mod-nav-item">
                    <i class="bi bi-person-check"></i>
                    <span>Restauration</span>
                </a>
                <a href="/moderation/sanctions" class="mod-nav-item">
                    <i class="bi bi-person-x"></i>
                    <span>Sanctions</span>
                </a>
                <a href="/moderation/mots-interdits" class="mod-nav-item">
                    <i class="bi bi-chat-square-text"></i>
                    <span>Mots interdits</span>
                </a>
                <a href="/moderation/support" class="mod-nav-item">
                    <i class="bi bi-chat-dots"></i>
                    <span>Support</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="mod-content">
            <h1 class="mod-page-title">Signalements</h1>

            <!-- Filter Tabs -->
            <div class="filter-tabs">
                <button class="filter-tab @(selectedCategory == "all" ? "active" : "")" @onclick='() => selectedCategory = "all"'>
                    Tous
                </button>
                <button class="filter-tab @(selectedCategory == "comptes" ? "active" : "")" @onclick='() => selectedCategory = "comptes"'>
                    Comptes
                </button>
                <button class="filter-tab @(selectedCategory == "posts" ? "active" : "")" @onclick='() => selectedCategory = "posts"'>
                    Posts
                </button>
                <button class="filter-tab @(selectedCategory == "messages" ? "active" : "")" @onclick='() => selectedCategory = "messages"'>
                    Messages privés
                </button>
                <button class="filter-tab @(selectedCategory == "avis" ? "active" : "")" @onclick='() => selectedCategory = "avis"'>
                    Avis
                </button>
            </div>

            <!-- Reports List -->
            <div class="reports-container">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="report-card">
                        <div class="report-header">
                            <div class="report-user">
                                <div class="report-avatar"></div>
                                <div>
                                    <h3>Denielz Denielzzz</h3>
                                    <p class="report-reason">a été signalé pour <span class="reason-highlight">Harcèlement</span></p>
                                </div>
                            </div>
                            <button class="btn-view" @onclick="() => ViewReport(i)">
                                Visualiser
                            </button>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>

