@page "/support"
@layout ClientLayout
@inject CreateSupportTicketViewModel VM

<PageTitle>Support - Clothes2U</PageTitle>

<div class="support-wrapper">
    <div class="support-container">
        <h1 class="support-title">Contacter le support</h1>

        <div class="support-card">
            <div class="form-group">
                <label class="form-label">Sujet</label>
                <input class="form-input" @bind="VM.Subject" />
            </div>

            <div class="form-group">
                <label class="form-label">Message</label>
                <textarea class="form-textarea" rows="5" @bind="VM.Message"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(VM.ErrorMessage))
            {
                <div class="alert-box is-danger">@VM.ErrorMessage</div>
            }

            <button class="btn-primary"
                    disabled="@VM.IsLoading"
                    @onclick="VM.SubmitAsync">
                @if (VM.IsLoading)
                {
                    <span class="spinner-small"></span>
                }
                Envoyer
            </button>
        </div>
    </div>
</div>


@code{

    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAsync();
    }

}