@page "/moderation/support"
@layout ModerationLayout
@using FrontBlazor.ViewModel.Moderation.Support
@inject SupportTicketsViewModel VM

<PageTitle>Support - Modération</PageTitle>
<link rel="stylesheet" href="/css/moderation-shared.css" />
<link href="css/Moderation/moderation-shared.css" rel="stylesheet"/>

@if (VM.IsLoading)
{
    <div class="loader"></div>
}
else
{
    <h1 class="mod-page-title">Demandes de support</h1>

    <div class="support-list">
        @foreach (var ticket in VM.Tickets)
        {
            <div class="support-card">
                <h4>@ticket.Title</h4>

                <button class="btn btn-sm btn-primary"
                        @onclick="() => VM.OpenDetails(ticket.TicketId)">
                    Répondre
                </button>
            </div>
        }
    </div>
}


@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAsync();
    }
}
