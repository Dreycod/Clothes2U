@page "/moderation/support"
@layout ModerationLayout
@using FrontBlazor.ViewModel.Moderation.Support
@using Shared.Enums
@inject SupportTicketsViewModel VM

<PageTitle>Support - Modération</PageTitle>
<link rel="stylesheet" href="/css/moderation-shared.css" />

@if (VM.IsLoading)
{
    <div class="empty-state">
        <i class="bi bi-hourglass-split"></i>
        <p>Chargement des tickets...</p>
    </div>
}
else
{
    <div class="mod-header">
        <h1 class="mod-page-title">
            <i class="bi bi-headset"></i>
            Demandes de support
        </h1>
        @if (VM.Tickets.Any())
        {
            <div class="mod-stats">
                <span class="stat-badge">
                    <i class="bi bi-ticket-perforated"></i>
                    @VM.Tickets.Count ticket@(VM.Tickets.Count > 1 ? "s" : "")
                </span>
            </div>
        }
    </div>

    <div class="filter-buttons" style="margin-bottom: 1.5rem; display: flex; gap: 0.75rem;">
        <button class="btn-filter @(VM.StatusTicket == StatusTicketEnum.OPEN ? "active" : "")"
                @onclick="LoadOpenTickets">
            <i class="bi bi-envelope-open"></i>
            En attente de réponse
        </button>
        <button class="btn-filter @(VM.StatusTicket == StatusTicketEnum.PENDING ? "active" : "")"
                @onclick="LoadPendingTickets">
            <i class="bi bi-clock-history"></i>
            En attente utilisateur
        </button>
        
        <button class="btn-filter @(VM.StatusTicket == StatusTicketEnum.CLOSED ? "active" : "")"
                @onclick="LoadClosedTickets">
            <i class="bi bi-lock"></i>
            Tickets fermés
        </button>
    </div>

    @if (!VM.Tickets.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>Aucune demande de support</h3>
            <p>Il n'y a actuellement aucun ticket @(VM.StatusTicket == StatusTicketEnum.OPEN ? "en attente de réponse" : "en attente de l'utilisateur").</p>
        </div>
    }
    else
    {
        <div class="support-list">
            @foreach (var ticket in VM.Tickets)
            {
                <div class="support-card">
                    <div class="support-card-header">
                        <div class="support-card-info">
                            <h3 class="support-card-title">@ticket.Title</h3>
                            <div class="support-card-meta">
                                <span class="meta-item">
                                    <i class="bi bi-person"></i>
                                    @ticket.LoginUser
                                </span>
                                <span class="meta-item">
                                    <i class="bi bi-calendar3"></i>
                                    @ticket.DateLastMessage.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")
                                </span>
                            </div>
                        </div>
                        <span class="support-status @(VM.StatusTicket == StatusTicketEnum.CLOSED ? "closed" : "pending")">
                            @if (VM.StatusTicket == StatusTicketEnum.CLOSED)
                            {
                                <i class="bi bi-lock"></i>
                                <span>Fermé</span>
                            }
                            else if (VM.StatusTicket == StatusTicketEnum.OPEN)
                            {
                                <i class="bi bi-clock-history"></i>
                                <span>En attente d'une réponse modérateur</span>
                            }
                            else if (VM.StatusTicket == StatusTicketEnum.PENDING)
                            {
                                <i class="bi bi-clock-history"></i>
                                <span>En attente utilisateur</span>
                            }
                        </span>

                    </div>

                    <div class="support-card-actions">
                        <button class="btn-action btn-primary"
                                @onclick="() => VM.OpenDetails(ticket.TicketId)">
                            <i class="bi bi-reply"></i>
                            @if (VM.StatusTicket == StatusTicketEnum.OPEN)
                            {
                                <span>Répondre</span>
                            }
                            else if (VM.StatusTicket == StatusTicketEnum.PENDING)
                            {
                                <span>Relancer</span>
                            }
                            else if (VM.StatusTicket == StatusTicketEnum.CLOSED)
                            {
                                <span>Consulter</span>
                            }
                        </button>

                    </div>
                </div>
            }
        </div>
    }
}

@code {

    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAsync();
    }

    private async Task LoadOpenTickets()
    {
        StateHasChanged();
        await VM.LoadOpenTickets();
        StateHasChanged();
    }

    private async Task LoadClosedTickets()
    {
        StateHasChanged();
        await VM.LoadClosedTickets();
        StateHasChanged();
    }

    private async Task LoadPendingTickets()
    {
        StateHasChanged();
        await VM.LoadPendingTickets();
        StateHasChanged();
    }
}