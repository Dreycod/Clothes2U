@page "/moderation/images"
@inject ImagesValidationViewModel VM_ImagesValidation
@layout ModerationLayout

<PageTitle>Validation d'images - Modération</PageTitle>


<link href="css/loading.css" rel="stylesheet" />
<link href="css/Moderation/moderation-shared.css" rel="stylesheet"/>
@if (VM_ImagesValidation.IsLoading)
{
    <div class="loader"></div>
}
else
{
    <main class="mod-content">
            <h1 class="mod-page-title">Validation d'images</h1>

            @if (VM_ImagesValidation._ValidationMessage.Any())
            {
                <div class="validation-messages">
                    @foreach (var msg in VM_ImagesValidation._ValidationMessage)
                    {
                        <div class="validation-message @(VM_ImagesValidation._IsSuccess ? "success" : "error")">
                            @msg
                        </div>
                    }
                </div>
            }
            <!-- Images Grid -->
            <div class="images-grid">
                @for (int i = 0; i < VM_ImagesValidation.SelectedFilePreviews.Count; i++)
                {
                    var preview = VM_ImagesValidation.SelectedFilePreviews[i];
                    var photoId = preview.PhotoID;
                    var Username = preview.Username;
                    var AnnonceID = preview.AnnonceID;

                    <div class="uploaded-photo" @key="photoId">
                        <img src="@preview.PreviewBase64" alt="Photo" />

                        <div class="image-info">
                            <div class="image-user">
                                <div class="user-avatar-small"></div>
                                <div class="user-meta">
                                    <h4>User: @(Username)</h4>
                                    <p>AnnonceID: @(AnnonceID)</p>
                                </div>
                            </div>

                            <div class="image-actions">
                                <button class="btn-approve"
                                        @onclick="async () => await VM_ImagesValidation.ApproveImage(photoId)">
                                    <i class="bi bi-check-lg"></i>
                                    Approuver
                                </button>

                                <button class="btn-reject"
                                        @onclick="async () => await VM_ImagesValidation.RejectImage(photoId)">
                                    <i class="bi bi-x-lg"></i>
                                    Refuser
                                </button>

                            </div>
                        </div>
                    </div>
                }
            </div>


        </main>
}


@code {
    protected override async Task OnInitializedAsync()
    {
        await VM_ImagesValidation.LoadAsync();
        VM_ImagesValidation.OnStateChanged += StateHasChanged;
    }

}
