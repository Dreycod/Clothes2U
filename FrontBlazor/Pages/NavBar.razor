﻿

<nav class="main-navbar">
    <div class="navbar-container">
        <!-- Logo and Menu -->
        <div class="navbar-left">
            <a href="/" class="navbar-logo">
                Clothes<span class="logo-accent">2</span>U
            </a>
            <button class="menu-toggle">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <!-- Search Bar -->
        <div class="navbar-search">
            <i class="bi bi-search search-icon" @onclick="NavigateToSearch" style="cursor: pointer;"></i>
            <input type="text"
                   class="search-input"
                   placeholder="Un nouveau t-shirt?"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown" />
        </div>

        <!-- Right Navigation -->
        <div class="navbar-right">
            <a href="#" class="nav-link">NOUVEAUTÉS</a>
            <a href="#" class="nav-link">TENDANCES</a>

            <button class="icon-btn" title="Notifications">
                <i class="bi bi-bell"></i>
            </button>

            <a href="/messages">
                <button class="icon-btn" title="Messages">
                    <i class="bi bi-chat-dots"></i>
                </button>
            </a>

            @if (isLoggedIn)
            {
                <!-- Profile Icon with Dropdown -->
                <div class="profile-dropdown-container">
                    <button class="icon-btn" title="Profil" @onclick="ToggleDropdown">
                        <i class="bi bi-person-circle"></i>
                    </button>

                    @if (showDropdown)
                    {
                        <div class="profile-dropdown">
                            <a href="/profile/@username" class="dropdown-item" @onclick="CloseDropdown">
                                <i class="bi bi-person"></i>
                                <span>Profil du compte</span>
                            </a>
                            <a href="/settings" class="dropdown-item" @onclick="CloseDropdown">
                                <i class="bi bi-gear"></i>
                                <span>Paramètres</span>
                            </a>
                            <button class="dropdown-item logout" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Se déconnecter</span>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Login Button -->
                <a href="/login" class="btn-login">
                    Login
                </a>
            }
        </div>
    </div>
</nav>

@code {
    private string searchQuery = string.Empty;
    private string username = "";
    private bool isLoggedIn = false;
    private bool showDropdown = false;

    private void NavigateToSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            navigationManager.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
        }
        else
        {
            navigationManager.NavigateTo("/search");
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            NavigateToSearch();
        }
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private async Task HandleLogout()
    {
        isLoggedIn = false;
        showDropdown = false;
        await VM_Connexion.HandleLogout();
        navigationManager.NavigateTo(navigationManager.Uri, true);
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckLoginStatus();

    }
    public async Task CheckLoginStatus()
    {
        bool loginStatus = await VM_Connexion.CheckLoginStatus();
        if (isLoggedIn != loginStatus)
        {
            isLoggedIn = loginStatus;
            StateHasChanged();
        }
    }
}