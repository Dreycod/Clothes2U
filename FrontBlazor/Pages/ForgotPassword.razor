@page "/forgot-password"

@inject ForgotPasswordViewModel VM

<PageTitle>Mot de passe oublié - Clothes2U</PageTitle>

<div class="auth-container">
    <div class="auth-content">

        <div class="auth-header">
            <h1 class="auth-logo">
                Clothes<span class="logo-accent">2</span>U
            </h1>
        </div>

        <div class="auth-card">
            <h2 class="forgot-title">Mot de passe oublié</h2>
            <p class="forgot-description">
                Entrez votre adresse mail et nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>

            <div class="auth-form">

                <!-- Email -->
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <div class="input-with-icon">
                        <i class="bi bi-envelope input-icon"></i>
                        <input type="email"
                               class="form-control"
                               placeholder="votremail@example.com"
                               @bind="VM.Email" />
                    </div>
                </div>

                <!-- Submit -->
                <button type="button"
                        class="btn-submit"
                        @onclick="VM.SubmitAsync"
                        disabled="@VM.IsLoading">

                    @if (VM.IsLoading)
                    {
                        <span class="spinner"></span>
                        <span>Envoi en cours...</span>
                    }
                    else
                    {
                        <span>Recevoir le lien</span>
                    }
                </button>

                <!-- Success -->
                @if (!string.IsNullOrEmpty(VM.SuccessMessage))
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i>
                        <span>@VM.SuccessMessage</span>
                    </div>
                }

                <!-- Error -->
                @if (!string.IsNullOrEmpty(VM.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@VM.ErrorMessage</span>
                    </div>
                }

                <div class="auth-footer">
                    <a href="/login" class="back-link">
                        Retour à la connexion
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
