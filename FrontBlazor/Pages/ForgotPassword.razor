@page "/forgot-password"

@inject NavigationManager NavigationManager

<PageTitle>Mot de passe oublié - Clothes2U</PageTitle>

<div class="auth-container">
    <div class="auth-content">
        <!-- Logo -->
        <div class="auth-header">
            <h1 class="auth-logo">Clothes<span class="logo-accent">2</span>U</h1>
        </div>

        <!-- Forgot Password Card -->
        <div class="auth-card">
            <h2 class="forgot-title">Mot de passe oublié</h2>
            <p class="forgot-description">
                Entrez votre adresse mail et nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>

            <div class="auth-form">
                <!-- Email Field -->
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <div class="input-with-icon">
                        <i class="bi bi-envelope input-icon"></i>
                        <input type="email" class="form-control" placeholder="votremail@example.com" @bind="email" />
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="button" class="btn-submit" @onclick="HandleForgotPassword" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner"></span>
                        <span>Envoi en cours...</span>
                    }
                    else
                    {
                        <span>Recevoir le lien</span>
                    }
                </button>

                <!-- Success Message -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i>
                        <span>@successMessage</span>
                    </div>
                }

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@errorMessage</span>
                    </div>
                }

                <!-- Back to Login Link -->
                <div class="auth-footer">
                    <a href="/login" class="back-link">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool isLoading = false;
    private string? successMessage;
    private string? errorMessage;

    private async Task HandleForgotPassword()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Veuillez entrer votre adresse email";
            return;
        }

        isLoading = true;

        try
        {
            // TODO: Implement forgot password logic
            await Task.Delay(1500); // Simulate API call

            successMessage = "Un lien de réinitialisation a été envoyé à votre adresse email";
            email = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = "Une erreur est survenue. Veuillez réessayer.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}