@page "/reset-password"

@inject ResetPasswordViewModel VM
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Components

<PageTitle>Réinitialisation du mot de passe</PageTitle>

<div class="auth-container">
    <div class="auth-content">

        <div class="auth-header">
            <h1 class="auth-logo">
                Clothes<span class="logo-accent">2</span>U
            </h1>
        </div>

        <div class="auth-card">
            <h2 class="forgot-title">Réinitialisation du mot de passe</h2>
            <p class="forgot-description">
                Entrez votre nouveau mot de passe.
            </p>

            <div class="auth-form">

                <!-- Nouveau mot de passe -->
                <div class="form-group">
                    <label class="form-label">Nouveau mot de passe</label>
                    <input type="password"
                           class="form-control"
                           @bind="VM.NewPassword"
                           placeholder="Minimum 8 caractères" />
                </div>

                <!-- Confirmation -->
                <div class="form-group">
                    <label class="form-label">Confirmer le mot de passe</label>
                    <input type="password"
                           class="form-control"
                           @bind="ConfirmPassword"
                           placeholder="Confirmez le mot de passe" />
                </div>

                <!-- Submit -->
                <button type="button"
                        class="btn-submit"
                        @onclick="Submit"
                        disabled="@VM.IsLoading">

                    @if (VM.IsLoading)
                    {
                        <span class="spinner"></span>
                        <span>Réinitialisation...</span>
                    }
                    else
                    {
                        <span>Réinitialiser le mot de passe</span>
                    }
                </button>

                <!-- Error -->
                @if (!string.IsNullOrEmpty(VM.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@VM.ErrorMessage</span>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string ConfirmPassword = "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        VM.Token = Token;
    }

    private async Task Submit()
    {
        VM.ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(VM.NewPassword))
        {
            VM.ErrorMessage = "Veuillez saisir un mot de passe.";
            return;
        }

        if (VM.NewPassword.Length < 8)
        {
            VM.ErrorMessage = "Le mot de passe doit contenir au moins 8 caractères.";
            return;
        }

        if (VM.NewPassword != ConfirmPassword)
        {
            VM.ErrorMessage = "Les mots de passe ne correspondent pas.";
            return;
        }

        await VM.SubmitAsync();
    }
}
