@page "/commercial/couleurs"

<PageTitle>Gestion des Couleurs - Clothes2U</PageTitle>

<link rel="stylesheet" href="/css/commercial-shared.css" />

<div class="commercial-page">
    <div class="commercial-container">
        <!-- Sidebar -->
        <aside class="commercial-sidebar">
            <div class="commercial-header">
                <div class="commercial-logo">
                    <i class="bi bi-shop"></i>
                    <div>
                        <h2>Clothes2U</h2>
                        <p>Équipe Commerciale</p>
                    </div>
                </div>
            </div>

            <nav class="commercial-nav">
                <a href="/commercial" class="commercial-nav-item">
                    <i class="bi bi-house-door"></i>
                    <span>Tableau de bord</span>
                </a>
                <a href="/commercial/marques" class="commercial-nav-item">
                    <i class="bi bi-tag"></i>
                    <span>Marques</span>
                </a>
                <a href="/commercial/categories" class="commercial-nav-item">
                    <i class="bi bi-grid"></i>
                    <span>Catégories</span>
                </a>
                <a href="/commercial/sous-categories" class="commercial-nav-item">
                    <i class="bi bi-diagram-3"></i>
                    <span>Sous-catégories</span>
                </a>
                <a href="/commercial/couleurs" class="commercial-nav-item active">
                    <i class="bi bi-palette"></i>
                    <span>Couleurs</span>
                </a>
                <a href="/commercial/tailles" class="commercial-nav-item">
                    <i class="bi bi-rulers"></i>
                    <span>Tailles</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="commercial-content">
            <div class="page-header">
                <h1 class="commercial-page-title">Gestion des Couleurs</h1>
                <button class="btn-primary" @onclick="VM_CommercialCouleurs.ShowAddModal">
                    <i class="bi bi-plus-circle"></i>
                    Ajouter une couleur
                </button>
            </div>

            @if (!string.IsNullOrEmpty(VM_CommercialCouleurs.successMessage))
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i>
                    <span>@VM_CommercialCouleurs.successMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(VM_CommercialCouleurs.errorMessage))
            {
                <div class="alert alert-error">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@VM_CommercialCouleurs.errorMessage</span>
                </div>
            }

            <!-- Colors Grid -->

            <div class="table-container">
                @if (VM_CommercialCouleurs.IsLoading)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Chargement des couleurs...</p>
                    </div>
                }
                else if (VM_CommercialCouleurs.Couleurs != null && VM_CommercialCouleurs.Couleurs.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nom de la marque</th>
                                <th>Nombre d'articles</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var couleur in VM_CommercialCouleurs.Couleurs)
                            {
                                <tr>
                                    <td>#@couleur.CouleurId</td>
                                    <td><strong>@couleur.Nom</strong></td>
                                    <td>@couleur.NombreProduits articles</td>
                                    <td>
                                        <div class="table-actions">
                                            <button class="btn-icon" title="Modifier" @onclick="() => VM_CommercialCouleurs.ShowEditModal(couleur)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn-icon danger" title="Supprimer" @onclick="() => VM_CommercialCouleurs.ShowDeleteModal(couleur)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-palette"></i>
                        <h3>Aucune couleur</h3>
                        <p>Commencez par ajouter votre première couleur</p>
                        <button class="btn-primary" @onclick="VM_CommercialCouleurs.ShowAddModal">
                            <i class="bi bi-plus-circle"></i>
                            Ajouter une couleur
                        </button>
                    </div>
                }
            </div>
        </main>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (VM_CommercialCouleurs.showModal)
{
    <div class="modal-overlay" @onclick="VM_CommercialCouleurs.CloseModal">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>@(VM_CommercialCouleurs.isEditing ? "Modifier" : "Ajouter") une couleur</h3>

            <div class="form-group">
                <label class="form-label">Nom de la couleur</label>
                <input type="text" class="form-input" placeholder="Ex: Rouge, Bleu, Vert..." @bind="VM_CommercialCouleurs.currentCouleur.Nom" />
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_CommercialCouleurs.CloseModal">Annuler</button>
                <button class="btn-primary" @onclick="VM_CommercialCouleurs.SaveCouleur">
                    @(VM_CommercialCouleurs.isEditing ? "Modifier" : "Ajouter")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Modal -->
@if (VM_CommercialCouleurs.showDeleteModal)
{
    <div class="modal-overlay" @onclick="VM_CommercialCouleurs.CloseDeleteModal">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Supprimer la couleur</h3>
            <p>Êtes-vous sûr de vouloir supprimer la couleur <strong>@VM_CommercialCouleurs.currentCouleur.Nom</strong> ?</p>
            <p style="color: #ef4444; font-size: 0.9rem;">Cette action est irréversible.</p>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="VM_CommercialCouleurs.CloseDeleteModal">Annuler</button>
                <button class="btn-danger" @onclick="VM_CommercialCouleurs.DeleteCouleur">Supprimer</button>
            </div>
        </div>
    </div>
}

@code {
   
    protected override async Task OnInitializedAsync()
    {
        await VM_CommercialCouleurs.LoadAsync();
        VM_CommercialCouleurs.OnStateChange += StateHasChanged;
    }
}
